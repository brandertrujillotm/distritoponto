---
import '../styles/global.css';
import { ClientRouter as ViewTransitions } from 'astro:transitions';

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
}

const {
	title = 'Distrito de Pontó | Pukapacha · Tierra Colorada',
	description = 'Plataforma comunitaria y de visión de desarrollo para el distrito de Pontó, Huari, Áncash. Construyendo futuro desde nuestras raíces de tierra colorada.',
	image = '/favicon.svg',
	canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="es-PE" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO y Metadatos Dinámicos -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url).href} />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:site_name" content="Distrito de Pontó - Pukapacha" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={Astro.url.href} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.url).href} />

		<!-- View Transitions -->
		<ViewTransitions />
	</head>
	<body class="flex min-h-screen flex-col bg-[#faf6f2] text-stone-900 antialiased selection:bg-orange-600 selection:text-white">
		<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/90 shadow-2xs backdrop-blur-md">
			<div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8 lg:px-10">
				<a href="/" class="group flex flex-col justify-center" aria-label="Pontó - Pukapacha, inicio">
					<span class="font-serif italic text-3xl font-bold text-red-600 transition-colors duration-200 group-hover:text-red-700 leading-none sm:text-4xl">Pontó</span>
					<span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 mt-1">Pukapacha · Tierra Colorada</span>
				</a>
				<nav class="hidden items-center gap-1 text-sm font-bold text-slate-800 md:flex lg:gap-2" aria-label="Navegación principal">
					<a href="/" class="rounded-lg px-3 py-2 text-slate-800 transition-colors duration-200 hover:text-red-600 hover:bg-slate-50 focus:outline-2 focus:outline-offset-2 focus:outline-red-500">Inicio</a>
					<a href="/identidad" class="rounded-lg px-3 py-2 text-slate-800 transition-colors duration-200 hover:text-red-600 hover:bg-slate-50 focus:outline-2 focus:outline-offset-2 focus:outline-red-500">Identidad</a>
					<a href="/propuestas" class="rounded-lg px-3 py-2 text-slate-800 transition-colors duration-200 hover:text-red-600 hover:bg-slate-50 focus:outline-2 focus:outline-offset-2 focus:outline-red-500">Propuestas</a>
					<a href="/diagnostico" class="rounded-lg px-3 py-2 text-slate-800 transition-colors duration-200 hover:text-red-600 hover:bg-slate-50 focus:outline-2 focus:outline-offset-2 focus:outline-red-500">Diagnóstico</a>
					<a href="/participa" class="rounded-xl bg-red-600 px-4 py-2 font-bold text-white shadow-2xs transition-all duration-200 hover:bg-red-700 hover:scale-[1.02] focus:outline-2 focus:outline-offset-2 focus:outline-red-500">Participa</a>
				</nav>
			</div>
			<!-- Menú móvil de navegación rápida -->
			<div class="flex items-center justify-between gap-1 overflow-x-auto border-t border-gray-200 bg-white/95 px-4 py-2 text-xs font-bold text-slate-700 md:hidden">
				<a href="/" class="whitespace-nowrap rounded px-2.5 py-1 transition hover:text-red-600">Inicio</a>
				<a href="/identidad" class="whitespace-nowrap rounded px-2.5 py-1 transition hover:text-red-600">Identidad</a>
				<a href="/propuestas" class="whitespace-nowrap rounded px-2.5 py-1 transition hover:text-red-600">Propuestas</a>
				<a href="/diagnostico" class="whitespace-nowrap rounded px-2.5 py-1 transition hover:text-red-600">Diagnóstico</a>
				<a href="/participa" class="whitespace-nowrap rounded bg-red-600 px-3 py-1 font-bold text-white shadow-2xs transition hover:bg-red-700">Participa</a>
			</div>
		</header>

		<!-- Contenedor semántico principal -->
		<main class="flex-grow">
			<slot />
		</main>

		<footer class="border-t-4 border-amber-600 bg-gradient-to-br from-[#240e08] via-stone-900 to-stone-950 text-stone-300">
			<div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-12 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-10">
				<div>
					<div class="flex items-center gap-3">
						<span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-amber-400 via-orange-500 to-red-600 text-lg font-black text-stone-950 shadow-md shadow-orange-950/40">P</span>
						<div>
							<p class="text-lg font-black uppercase tracking-widest text-white">Distrito de Pontó</p>
							<p class="text-xs font-bold uppercase tracking-wider text-amber-400">Pukapacha · Plataforma Comunitaria</p>
						</div>
					</div>
					<p class="mt-4 max-w-md text-sm leading-6 text-stone-400">Plataforma comunitaria y de visión de desarrollo para el distrito de Pontó, Áncash. Construyendo futuro desde nuestras raíces de tierra colorada.</p>
				</div>
				<div class="flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:gap-6 lg:text-right">
					<div class="flex flex-wrap gap-4 text-xs font-bold text-stone-300 sm:text-sm">
						<a href="/" class="transition hover:text-amber-300">Inicio</a>
						<a href="/identidad" class="transition hover:text-amber-300">Identidad</a>
						<a href="/propuestas" class="transition hover:text-amber-300">Propuestas</a>
						<a href="/diagnostico" class="transition hover:text-amber-300">Diagnóstico</a>
						<a href="/participa" class="transition hover:text-amber-300">Participa</a>
					</div>
					<div class="border-t border-white/10 pt-3 sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">
						<p class="font-bold text-amber-300">Pontó · Huari, Áncash</p>
						<p class="text-xs text-stone-400">Visión y Desarrollo Comunitario</p>
					</div>
				</div>
			</div>
			<div class="border-t border-white/10 px-5 py-5 text-center text-xs text-stone-400 sm:px-8">© {new Date().getFullYear()} Plataforma Comunitaria de Pontó (Pukapacha). Impulsando la visión y desarrollo integral del distrito.</div>
		</footer>
	</body>
</html>
