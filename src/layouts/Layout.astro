---
import '../styles/global.css';

interface Props {
	 title?: string;
}

const { title = 'Visión y Desarrollo para Pontó | Pukapacha' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-stone-50 text-stone-900 antialiased selection:bg-orange-500 selection:text-white">
		<header class="sticky top-0 z-50 border-b border-[#7c2d12]/50 bg-[#240e08]/95 text-white shadow-xl shadow-stone-950/20 backdrop-blur-md">
			<div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8 lg:px-10">
				<a href="/" class="group flex min-w-0 items-center gap-3" aria-label="Pontó - Pukapacha, inicio">
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-amber-400 via-orange-500 to-red-600 text-xl font-black text-stone-950 shadow-lg shadow-orange-950/40 transition-transform duration-300 group-hover:scale-105">P</span>
					<div class="flex flex-col truncate">
						<span class="truncate text-sm font-black uppercase tracking-[0.18em] text-white sm:text-base">Distrito de Pontó</span>
						<span class="text-[10px] font-bold uppercase tracking-widest text-amber-300/90">Pukapacha · Tierra Colorada</span>
					</div>
				</a>
				<nav class="hidden items-center gap-2 text-sm font-bold text-stone-200 md:flex lg:gap-3" aria-label="Navegación principal">
					<a href="/" class="rounded-lg px-3 py-2 transition-all duration-200 hover:bg-white/10 hover:text-amber-300 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400">Inicio</a>
					<a href="/identidad" class="rounded-lg px-3 py-2 transition-all duration-200 hover:bg-white/10 hover:text-amber-300 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400">Identidad</a>
					<a href="/propuestas" class="rounded-lg px-3 py-2 transition-all duration-200 hover:bg-white/10 hover:text-amber-300 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400">Propuestas</a>
					<a href="/diagnostico" class="rounded-lg px-3 py-2 transition-all duration-200 hover:bg-white/10 hover:text-amber-300 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400">Diagnóstico</a>
					<a href="/participa" class="rounded-lg bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 px-4 py-2 font-black text-stone-950 shadow-md shadow-orange-950/25 transition-all duration-200 hover:brightness-110 hover:shadow-lg focus:outline-2 focus:outline-offset-2 focus:outline-amber-400">Participa</a>
				</nav>
			</div>
			<!-- Menú móvil de navegación rápida con exactamente las cinco pestañas -->
			<div class="flex items-center justify-between gap-1 overflow-x-auto border-t border-[#7c2d12]/40 bg-[#1c0b06] px-4 py-2 text-xs font-bold text-stone-300 md:hidden">
				<a href="/" class="whitespace-nowrap rounded px-2.5 py-1 transition hover:text-amber-300">Inicio</a>
				<a href="/identidad" class="whitespace-nowrap rounded px-2.5 py-1 transition hover:text-amber-300">Identidad</a>
				<a href="/propuestas" class="whitespace-nowrap rounded px-2.5 py-1 transition hover:text-amber-300">Propuestas</a>
				<a href="/diagnostico" class="whitespace-nowrap rounded px-2.5 py-1 transition hover:text-amber-300">Diagnóstico</a>
				<a href="/participa" class="whitespace-nowrap rounded bg-gradient-to-r from-amber-500 to-orange-500 px-2.5 py-1 text-stone-950 shadow-sm">Participa</a>
			</div>
		</header>

		<slot />

		<footer class="border-t-4 border-amber-600 bg-gradient-to-br from-[#240e08] via-stone-900 to-stone-950 text-stone-300">
			<div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-12 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-10">
				<div>
					<div class="flex items-center gap-3">
						<span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-amber-400 via-orange-500 to-red-600 text-lg font-black text-stone-950 shadow-md shadow-orange-950/40">P</span>
						<div>
							<p class="text-lg font-black uppercase tracking-widest text-white">Distrito de Pontó</p>
							<p class="text-xs font-bold uppercase tracking-wider text-amber-400">Pukapacha · Plataforma Comunitaria</p>
						</div>
					</div>
					<p class="mt-4 max-w-md text-sm leading-6 text-stone-400">Plataforma comunitaria y de visión de desarrollo para el distrito de Pontó, Áncash. Construyendo futuro desde nuestras raíces de tierra colorada.</p>
				</div>
				<div class="flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:gap-6 lg:text-right">
					<div class="flex flex-wrap gap-4 text-xs font-bold text-stone-300 sm:text-sm">
						<a href="/" class="transition hover:text-amber-300">Inicio</a>
						<a href="/identidad" class="transition hover:text-amber-300">Identidad</a>
						<a href="/propuestas" class="transition hover:text-amber-300">Propuestas</a>
						<a href="/diagnostico" class="transition hover:text-amber-300">Diagnóstico</a>
						<a href="/participa" class="transition hover:text-amber-300">Participa</a>
					</div>
					<div class="border-t border-white/10 pt-3 sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">
						<p class="font-bold text-amber-300">Pontó · Huari, Áncash</p>
						<p class="text-xs text-stone-400">Visión y Desarrollo Comunitario</p>
					</div>
				</div>
			</div>
			<div class="border-t border-white/10 px-5 py-5 text-center text-xs text-stone-400 sm:px-8">© {new Date().getFullYear()} Plataforma Comunitaria de Pontó (Pukapacha). Impulsando la visión y desarrollo integral del distrito.</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
