---
import Layout from '../layouts/Layout.astro';

// Propuestas prioritarias estructuradas
const propuestas = [
  {
    numero: '01',
    titulo: 'Siembra y Cosecha de Agua',
    icono: 'agua',
    categoria: 'Recursos Hídricos y Agricultura',
    resumen: 'Reservorios comunales y canales para tecnificar el riego y asegurar cosechas durante todo el año.',
    beneficios: [
      'Mayor productividad agrícola y diversificación de cultivos en todos los sectores.',
      'Seguridad hídrica garantizada durante los meses críticos de estiaje.',
      'Disminución de pérdidas de caudal mediante conducción entubada y reservorios.',
      'Protección comunal de manantiales y cochas en cabeceras de cuenca.',
    ],
  },
  {
    numero: '02',
    titulo: 'Transitabilidad y Vías Seguras',
    icono: 'vias',
    categoria: 'Infraestructura Vial y Conectividad',
    resumen: 'Mantenimiento constante de trochas carrozables y caminos rurales para unir a todos los caseríos.',
    beneficios: [
      'Interconexión fluida y permanente entre la capital, centros poblados y los 14 anexos.',
      'Traslado seguro y económico de cosechas hacia ferias y mercados provinciales.',
      'Prevención de cortes de ruta y derrumbes mediante cunetas y drenajes adecuados.',
      'Acceso oportuno para vehículos de auxilio médico y emergencias comunitarias.',
    ],
  },
  {
    numero: '03',
    titulo: 'Educación y Conectividad Digital',
    icono: 'educacion',
    categoria: 'Desarrollo Social y Juventud',
    resumen: 'Acceso a internet comunitario, equipamiento para escuelas y talleres técnicos para la juventud.',
    beneficios: [
      'Reducción efectiva de la brecha digital en las escuelas rurales de los caseríos.',
      'Acceso a herramientas pedagógicas modernas y recursos de investigación digital.',
      'Talleres formativos orientados al emprendimiento agropecuario y tecnológico juvenil.',
      'Espacios comunitarios conectados para trámites ciudadanos y comunicación vecinal.',
    ],
  },
  {
    numero: '04',
    titulo: 'Salud Rural y Agua Potable',
    icono: 'salud',
    categoria: 'Salud Pública y Bienestar',
    resumen: 'Fortalecimiento de postas de salud, campañas médicas y cloración de agua para erradicar la anemia.',
    beneficios: [
      'Atención médica digna con disponibilidad regular de medicamentos de primera necesidad.',
      'Consumo de agua segura mediante sistemas de cloración supervisados en cada anexo.',
      'Lucha frontal contra la anemia y desnutrición en niñas, niños y madres gestantes.',
      'Campañas de salud preventiva periódicas que lleguen a los caseríos más alejados.',
    ],
  },
];
---

<Layout
  title="Ejes de Desarrollo Comunitario | Propuestas para Pontó"
  description="Conoce los proyectos y propuestas prioritarias para Pontó en riego tecnificado, infraestructura vial, impulso agropecuario, educación y salud rural."
>
  <div class="min-h-screen bg-slate-50/70 text-slate-800">
    <!-- BLOQUE 1: HERO SECTION (Limpio, directo y amigable) -->
    <section class="relative isolate overflow-hidden border-b border-slate-200/70 bg-white px-5 pb-16 pt-16 sm:px-8 sm:pb-24 sm:pt-20 lg:px-10 shadow-xs">
      <!-- Fondo neutro con respiración visual -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-100/60 via-white to-white"></div>

      <div class="relative mx-auto max-w-4xl text-center">
        <!-- Badge institucional -->
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-slate-600 shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-red-600"></span>
          Plan de Acción Comunitario
        </span>

        <!-- Título Principal -->
        <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Ejes de Desarrollo <span class="text-red-600">Comunitario</span>
        </h1>

        <!-- Descripción del Hero -->
        <p class="mx-auto mt-4 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg sm:leading-8">
          En esta página se presentarán a detalle los proyectos prioritarios para Pontó, organizados por sectores clave como riego tecnificado, infraestructura vial, impulso productivo agropecuario y bienestar social.
        </p>

        <!-- Indicadores de enfoque metodológico -->
        <div class="mt-8 flex flex-wrap justify-center gap-2.5 sm:gap-3 text-xs font-bold text-slate-700">
          <span class="rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 shadow-2xs">
            🌱 Sostenibilidad Hídrica
          </span>
          <span class="rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 shadow-2xs">
            🛣️ Conectividad Territorial
          </span>
          <span class="rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 shadow-2xs">
            📚 Oportunidades Juveniles
          </span>
          <span class="rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 shadow-2xs">
            🏥 Salud Preventiva
          </span>
        </div>
      </div>
    </section>

    <!-- BLOQUE 2: TARJETAS DE PROPUESTAS (Contenedor amplio en Grid 2x2 con números destacados) -->
    <section class="px-5 py-16 sm:px-8 sm:py-24 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center sm:text-left">
          <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-slate-500">
            <span class="h-2 w-2 rounded-full bg-red-600"></span>
            Proyectos Priorizados
          </span>
          <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
            Iniciativas Estratégicas para el Distrito
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
            Cada propuesta responde a las demandas recogidas en los anexos, orientadas a generar beneficios concretos y medibles para nuestras familias.
          </p>
        </div>

        <!-- Grid de las 4 Propuestas -->
        <div class="grid gap-8 lg:grid-cols-2">
          {propuestas.map((propuesta) => (
            <article class="group relative flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-xl hover:shadow-slate-950/5 sm:p-9">
              <div>
                <!-- Encabezado de la tarjeta: Ícono, Categoría y Número Destacado -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <!-- Ícono minimalista -->
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 text-slate-700 transition-colors duration-300 group-hover:border-red-200 group-hover:bg-red-50 group-hover:text-red-600">
                      {propuesta.icono === 'agua' && (
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a7.5 7.5 0 0 0 7.5-7.5c0-4.14-7.5-11.25-7.5-11.25S4.5 9.36 4.5 13.5A7.5 7.5 0 0 0 12 21Z" />
                        </svg>
                      )}
                      {propuesta.icono === 'vias' && (
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4 19 8 5m8 0 4 14M12 5v2m0 5v2m0 5v2" />
                        </svg>
                      )}
                      {propuesta.icono === 'educacion' && (
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-5.25 6.557q-.298.118-.592.242" />
                        </svg>
                      )}
                      {propuesta.icono === 'salud' && (
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                        </svg>
                      )}
                    </div>
                    <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-bold text-slate-600">
                      {propuesta.categoria}
                    </span>
                  </div>

                  <!-- Número grande con color sutil y transición de acento al hacer hover -->
                  <span class="font-mono text-4xl sm:text-5xl font-black tracking-tight text-slate-200 transition-colors duration-300 group-hover:text-red-600/30 select-none">
                    {propuesta.numero}
                  </span>
                </div>

                <!-- Título de la Propuesta -->
                <h3 class="mt-6 text-2xl font-black text-slate-900 transition-colors duration-300 group-hover:text-slate-950">
                  {propuesta.titulo}
                </h3>

                <!-- Resumen descriptivo principal -->
                <p class="mt-3 text-base leading-7 text-slate-600">
                  {propuesta.resumen}
                </p>

                <!-- Bloque de Beneficios Esperados con Checkmarks -->
                <div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50/70 p-5">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">
                    Beneficios esperados:
                  </h4>
                  <ul class="mt-3 space-y-2.5">
                    {propuesta.beneficios.map((beneficio) => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm leading-6 text-slate-600">
                        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600 text-[11px] font-black" aria-hidden="true">
                          ✓
                        </span>
                        <span>{beneficio}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Pie de tarjeta -->
              <div class="mt-8 flex items-center justify-between border-t border-slate-100 pt-4 text-xs font-bold text-slate-500">
                <span>Alcance: Nivel Distrital</span>
                <span class="text-slate-700 group-hover:text-red-600 transition-colors">
                  Eje Prioritario &rarr;
                </span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOQUE 3: LLAMADO A LA ACCIÓN (Conexión Amigable con 'Participa') -->
    <section class="border-t border-slate-200/70 bg-slate-50 py-16 sm:py-24 px-5 sm:px-8 lg:px-10">
      <div class="mx-auto max-w-4xl rounded-3xl border border-slate-200/90 bg-white p-8 text-center shadow-sm sm:p-12">
        <span class="inline-flex items-center gap-2 rounded-full border border-red-200/80 bg-red-50/70 px-4 py-1 text-xs font-bold uppercase tracking-wider text-red-700">
          <span class="h-1.5 w-1.5 rounded-full bg-red-600"></span>
          Construcción Participativa
        </span>

        <h2 class="mt-4 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
          ¿Deseas aportar una propuesta o sugerencia para tu sector?
        </h2>

        <p class="mx-auto mt-3 max-w-2xl text-base leading-7 text-slate-600">
          Estos cuatro ejes son un punto de partida técnico y abierto. Si representas a una comunidad o tienes ideas específicas para complementar el plan de desarrollo, súmate a la mesa de aportes ciudadanos.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a
            href="/participa"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-7 py-3.5 text-sm font-bold text-white shadow-sm shadow-red-950/10 transition-all duration-300 hover:bg-red-700 hover:scale-[1.02] focus:outline-2 focus:outline-offset-2 focus:outline-red-500"
          >
            Enviar Propuesta Ciudadana &rarr;
          </a>

          <a
            href="/diagnostico"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-7 py-3.5 text-sm font-bold text-slate-700 shadow-2xs transition-all duration-300 hover:bg-slate-50 hover:border-slate-400 hover:text-slate-900"
          >
            Revisar el Diagnóstico Territorial
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
