---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const obras = (await getCollection('obras')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

const estadoStyles = {
  'en ejecución': 'bg-amber-100 text-amber-900 ring-amber-300',
  terminada: 'bg-orange-100 text-orange-950 ring-orange-300',
  planificada: 'bg-stone-100 text-stone-900 ring-stone-300',
} as const;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-PE', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  }).format(date);
---

<Layout title="Proyectos y Diagnóstico de Obras | Pontó">
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <section class="border-b border-[#7c2d12]/40 bg-gradient-to-r from-[#240c07] via-[#4d190f] to-[#7c2b1a] text-white">
      <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-18 lg:px-10 lg:py-20">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-amber-300"><span class="h-px w-9 bg-amber-400"></span>Diagnóstico y seguimiento territorial</p>
        <h1 class="mt-5 max-w-3xl text-4xl font-black leading-tight tracking-tight text-white sm:text-6xl">Proyectos y Avance de Obras</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-stone-200 sm:text-lg">Conoce los proyectos prioritarios para Pontó (Pukapacha), su estado actual y el seguimiento comunitario para el bienestar de nuestros caseríos.</p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16 lg:px-10" aria-labelledby="listado-obras">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-stone-500">Cartera comunitaria</p>
          <h2 id="listado-obras" class="mt-2 text-2xl font-black tracking-tight text-stone-950 sm:text-3xl">Proyectos registrados</h2>
        </div>
        <span class="hidden rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-stone-600 ring-1 ring-stone-200 sm:inline-flex">{obras.length} {obras.length === 1 ? 'proyecto' : 'proyectos'}</span>
      </div>

      {obras.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {obras.map((obra) => (
            <article class="group flex h-full flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-orange-300 hover:shadow-xl hover:shadow-stone-200/70">
              <div class="relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-[#3b150c] via-orange-950 to-[#742718]">
                <img src={obra.data.imagen} alt={`Imagen de ${obra.data.titulo}`} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-stone-950/50 via-transparent to-transparent"></div>
                <span class={`absolute left-4 top-4 inline-flex rounded-full px-3 py-1 text-xs font-bold capitalize ring-1 ${estadoStyles[obra.data.estado]}`}>
                  {obra.data.estado}
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5 sm:p-6">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Fecha de registro</p>
                <time datetime={obra.data.fecha.toISOString()} class="mt-1 text-sm font-semibold text-slate-600">{formatDate(obra.data.fecha)}</time>
                <h3 class="mt-5 text-xl font-bold leading-snug text-slate-950">{obra.data.titulo}</h3>
                <p class="mt-3 flex-1 text-sm leading-6 text-slate-600">{obra.data.descripcion}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
          <h2 class="text-xl font-bold text-slate-900">Aún no hay obras publicadas</h2>
          <p class="mt-2 text-sm text-slate-500">Pronto encontrarás aquí los proyectos de la Municipalidad Distrital de Pontó.</p>
        </div>
      )}
    </section>

  </main>
</Layout>
