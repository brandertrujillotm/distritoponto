---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Pontó: Tierra Pukapacha | Plataforma Distrital"
  description="Propuestas técnicas, diagnóstico real y visión comunitaria para el desarrollo integral del distrito de Pontó, provincia de Huari, Áncash."
>
  <div class="min-h-screen bg-slate-50/70 text-slate-800">
    <!-- BLOQUE 1: Hero Section (Limpio, luminoso y equilibrado con blanco puro y acentos Pukapacha) -->
    <section class="relative isolate overflow-hidden bg-white px-5 pb-20 pt-16 sm:px-8 sm:pb-28 sm:pt-24 lg:px-10 border-b border-slate-200/70 shadow-xs">
      <!-- Decoración de fondo sutil y neutra para dar amplitud y descanso visual -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-100/60 via-white to-white"></div>
      
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <!-- Etiqueta superior con acento sutil -->
          <span class="inline-flex items-center gap-2 rounded-full border border-red-200/80 bg-red-50/70 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-red-700 shadow-2xs">
            <span class="h-1.5 w-1.5 rounded-full bg-red-600"></span>
            Visión y Desarrollo Distrital
          </span>

          <!-- Título Principal: Contraste elegante con gradiente sutil y armónico -->
          <h1 class="mt-6 text-4xl font-black leading-[1.08] tracking-tight text-slate-900 sm:text-6xl lg:text-7xl">
            Pontó: <span class="inline-block animate-gradient bg-gradient-to-r from-red-600 via-rose-600 to-slate-800 bg-[length:200%_auto] bg-clip-text text-transparent pb-1">Tierra Pukapacha</span>
          </h1>

          <!-- Subtítulo en gris pizarra elegante para descanso visual -->
          <p class="mt-6 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg sm:leading-8">
            Desde las aguas del río Puchca hasta las alturas de Parashapampa, somos un distrito de herencia milenaria. Una iniciativa ciudadana para impulsar soluciones viables en nuestra capital, 2 centros poblados y 14 anexos.
          </p>

          <!-- Botones de Acción: Rojo estratégico como acento principal y neutro de alto contraste -->
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <!-- Botón Principal: Rojo Pukapacha estilizado -->
            <a
              href="/propuestas"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-7 py-4 text-sm font-bold text-white shadow-sm shadow-red-950/10 transition-all duration-300 hover:bg-red-700 hover:shadow-md hover:scale-[1.02] focus:outline-2 focus:outline-offset-4 focus:outline-red-500"
            >
              Ver Propuestas <span aria-hidden="true">&rarr;</span>
            </a>

            <!-- Botón Secundario: Blanco neutro con borde sutil -->
            <a
              href="/diagnostico"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-7 py-4 text-sm font-bold text-slate-700 shadow-2xs transition-all duration-300 hover:bg-slate-50 hover:border-slate-400 hover:text-slate-900 hover:scale-[1.02] focus:outline-2 focus:outline-offset-4 focus:outline-slate-500"
            >
              Nuestro Diagnóstico <span aria-hidden="true">&#8595;</span>
            </a>
          </div>
        </div>

        <!-- Portada visual con mural representativo y datos clave -->
        <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
          <div class="relative overflow-hidden rounded-3xl border border-slate-200/90 bg-slate-900 shadow-xl shadow-slate-950/5">
            <div class="relative aspect-[4/3] w-full overflow-hidden">
              <img
                src="/images/ponto-arte-identidad.jpg"
                alt="Paisaje cultural y muralismo en la tierra de Pontó"
                class="h-full w-full object-cover transition duration-700 hover:scale-105"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              
              <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
                <span class="inline-flex rounded-full border border-white/20 bg-white/15 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-100 backdrop-blur-md">
                  Pukapacha · Huari, Áncash
                </span>
                <p class="mt-2 text-lg font-bold text-white sm:text-xl">
                  De Puchca a Parashapampa: identidad, agricultura y futuro compartido.
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2.5 text-xs font-medium text-slate-200">
                  <span class="rounded-lg bg-slate-900/60 border border-white/10 px-2.5 py-1 backdrop-blur-xs">📍 3,140 m s. n. m.</span>
                  <span class="rounded-lg bg-slate-900/60 border border-white/10 px-2.5 py-1 backdrop-blur-xs">🌾 118.29 km²</span>
                  <span class="rounded-lg bg-slate-900/60 border border-white/10 px-2.5 py-1 backdrop-blur-xs">🤝 Capital, 2 C.P. y 14 Anexos</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOQUE 2: Nuestros Pilares de Visión (Tarjetas con acentos diferenciados y armónicos) -->
    <section class="py-20 sm:py-28 px-5 sm:px-8 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center sm:text-left">
          <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-slate-600 shadow-2xs">
            <span class="h-1.5 w-1.5 rounded-full bg-red-600"></span>
            Ejes Estratégicos
          </span>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
            Nuestros <span class="text-red-600">Pilares</span> de Visión
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
            Compromisos centrales para transformar el potencial productivo, social y cultural de nuestro distrito con equilibrio y rigor técnico.
          </p>
        </div>

        <div class="grid gap-7 md:grid-cols-3">
          <!-- Pilar 1: Agua y Agricultura (Acompañado con Verde Esmeralda suave) -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1.5 hover:border-emerald-300 hover:shadow-xl hover:shadow-emerald-950/5 sm:p-8">
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono con acento verde esmeralda -->
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-100 bg-emerald-50 text-emerald-600 transition duration-300 group-hover:scale-110">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a7.5 7.5 0 0 0 7.5-7.5c0-4.14-7.5-11.25-7.5-11.25S4.5 9.36 4.5 13.5A7.5 7.5 0 0 0 12 21Z" />
                  </svg>
                </div>
                <span class="rounded-full border border-emerald-200/70 bg-emerald-50/60 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-emerald-800">
                  Pilar 01
                </span>
              </div>

              <h3 class="mt-6 text-xl font-bold text-slate-900 group-hover:text-emerald-900 transition-colors">
                Agua y Agricultura
              </h3>

              <p class="mt-3 text-sm leading-7 text-slate-600">
                Impulsamos la eficiencia hídrica y el riego tecnificado para transformar nuestro minifundio y potenciar desde los frutales de Yunguilla hasta las cosechas de Cuchos.
              </p>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-slate-100 pt-4 text-xs font-bold uppercase tracking-wider text-emerald-700">
              <span>Eficiencia hídrica y riego</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- Pilar 2: Integración y Conectividad (Acompañado con Azul Pizarra neutro) -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1.5 hover:border-slate-400 hover:shadow-xl hover:shadow-slate-950/5 sm:p-8">
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono con acento pizarra -->
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-slate-200 bg-slate-100 text-slate-700 transition duration-300 group-hover:scale-110">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 19 8 5m8 0 4 14M12 5v2m0 5v2m0 5v2" />
                  </svg>
                </div>
                <span class="rounded-full border border-slate-200 bg-slate-100/70 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-700">
                  Pilar 02
                </span>
              </div>

              <h3 class="mt-6 text-xl font-bold text-slate-900 group-hover:text-slate-800 transition-colors">
                Integración y Conectividad
              </h3>

              <p class="mt-3 text-sm leading-7 text-slate-600">
                Proponemos el cierre de brechas en infraestructura vial y conectividad digital para articular a San Miguel, Conin y todas nuestras comunidades campesinas.
              </p>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-slate-100 pt-4 text-xs font-bold uppercase tracking-wider text-slate-700">
              <span>Caminos rurales e internet</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- Pilar 3: Identidad y Turismo (Acompañado con Rojo Terracota Estratégico) -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1.5 hover:border-red-300 hover:shadow-xl hover:shadow-red-950/5 sm:p-8">
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono con acento rojo Pukapacha -->
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-red-100 bg-red-50 text-red-600 transition duration-300 group-hover:scale-110">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m3 20 8-14 3.5 6 2.5-4 4 12H3Z" />
                    <circle cx="18" cy="6" r="2.5" />
                  </svg>
                </div>
                <span class="rounded-full border border-red-200/70 bg-red-50/60 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-red-700">
                  Pilar 03
                </span>
              </div>

              <h3 class="mt-6 text-xl font-bold text-slate-900 group-hover:text-red-700 transition-colors">
                Identidad y Turismo
              </h3>

              <p class="mt-3 text-sm leading-7 text-slate-600">
                Revaloramos el Qhapaq Ñan, nuestros petroglifos y el muralismo comunal como motores de una nueva economía ecoturística y cultural sostenible.
              </p>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-slate-100 pt-4 text-xs font-bold uppercase tracking-wider text-red-700">
              <span>Qhapaq Ñan y arte comunal</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- BLOQUE 3: Explora nuestra plataforma (Bento Grid limpio con tarjetas blancas y contraste sobrio) -->
    <section class="border-t border-slate-200/70 bg-white py-20 sm:py-28 px-5 sm:px-8 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center sm:text-left">
          <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-slate-600">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span>
            Navegación Rápida
          </span>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
            Explora nuestra plataforma
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
            Conoce a fondo las propuestas técnicas, la memoria histórica de nuestra tierra y súmate a la visión de Pontó.
          </p>
        </div>

        <!-- Grilla Bento con tarjetas sobrias y elegantes -->
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Banner 1: Conoce nuestra Identidad -->
          <a
            href="/identidad"
            class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-red-300 hover:shadow-xl hover:shadow-slate-950/5 focus:outline-2 focus:outline-offset-2 focus:outline-red-400"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-red-100 bg-red-50 text-red-600 transition duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 1-9-9c0-4.97 4.03-9 9-9 3.5 0 6.54 1.99 8.04 4.91M12 21c4.97 0 9-4.03 9-9 0-1.12-.2-2.19-.58-3.18M12 21V9m0 0a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm0 0a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" />
                </svg>
              </div>
              <h3 class="mt-5 text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
                Conoce nuestra Identidad
              </h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                La historia de Pontó Viejo, nuestra resiliencia y toponimia.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-red-700">
              <span>Explorar</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
            </div>
          </a>

          <!-- Banner 2: Lee el Diagnóstico -->
          <a
            href="/diagnostico"
            class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-slate-400 hover:shadow-xl hover:shadow-slate-950/5 focus:outline-2 focus:outline-offset-2 focus:outline-slate-400"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-slate-200 bg-slate-100 text-slate-700 transition duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                </svg>
              </div>
              <h3 class="mt-5 text-lg font-bold text-slate-900 group-hover:text-slate-800 transition-colors">
                Lee el Diagnóstico
              </h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                Un análisis técnico y realista de las necesidades del distrito.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700">
              <span>Explorar</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
            </div>
          </a>

          <!-- Banner 3: Descubre las Propuestas -->
          <a
            href="/propuestas"
            class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-emerald-300 hover:shadow-xl hover:shadow-slate-950/5 focus:outline-2 focus:outline-offset-2 focus:outline-emerald-400"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-100 bg-emerald-50 text-emerald-700 transition duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.439a8.966 8.966 0 0 1-4.5 0m4.5 0v1.5a1.5 1.5 0 0 1-1.5 1.5h-1.5a1.5 1.5 0 0 1-1.5-1.5v-1.5m3.75-9.75a6 6 0 1 0-7.5 0" />
                </svg>
              </div>
              <h3 class="mt-5 text-lg font-bold text-slate-900 group-hover:text-emerald-800 transition-colors">
                Descubre las Propuestas
              </h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                Iniciativas y proyectos planificados para Áncash.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-700">
              <span>Explorar</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
            </div>
          </a>

          <!-- Banner 4: Suma tu Voz (Diseño sobrio en pizarra oscura con botón de acento) -->
          <a
            href="/participa"
            class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 p-7 text-white transition-all duration-300 hover:-translate-y-1.5 hover:bg-slate-950 hover:shadow-2xl hover:shadow-slate-950/20 focus:outline-2 focus:outline-offset-2 focus:outline-slate-700"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-red-500/30 bg-red-600/20 text-red-400 backdrop-blur-md transition duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" />
                </svg>
              </div>
              <h3 class="mt-5 text-lg font-bold text-white group-hover:text-red-400 transition-colors">
                Suma tu Voz
              </h3>
              <p class="mt-2 text-sm leading-6 text-slate-300">
                Participa y envíanos las necesidades y prioridades de tu caserío.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-red-400">
              <span>Participar</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Botón Flotante de WhatsApp: Participación Ciudadana -->
    <a
      href="https://wa.me/?text=Hola%2C%20quisiera%20enviar%20una%20propuesta%20o%20consulta%20para%20el%20Distrito%20de%20Pont%C3%B3"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 flex items-center gap-2.5 rounded-full bg-[#25D366] px-4 py-3.5 text-white shadow-xl shadow-emerald-950/20 transition-all duration-300 hover:scale-105 hover:bg-[#20ba5a] hover:shadow-emerald-600/30 focus:outline-2 focus:outline-offset-4 focus:outline-emerald-500 group"
      aria-label="Contactar por WhatsApp para participación ciudadana"
    >
      <svg class="h-6 w-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span class="hidden text-xs font-bold tracking-wider uppercase sm:inline-block">Participa x WhatsApp</span>
    </a>
  </div>
</Layout>

<style>
  /* Animación suave y continua: rojo terracota Pukapacha que transiciona hacia gris pizarra */
  @keyframes gradient-flow {
