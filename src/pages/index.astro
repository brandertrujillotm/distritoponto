---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const obras = (await getCollection('obras')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

const obrasDestacadas = obras.slice(0, 3);

const progresoPorEstado = {
  'en ejecución': 65,
  terminada: 100,
  planificada: 20,
} as const;

const estadoStyles = {
  'en ejecución': 'bg-amber-100 text-amber-950 ring-amber-300',
  terminada: 'bg-orange-100 text-orange-950 ring-orange-300',
  planificada: 'bg-stone-100 text-stone-900 ring-stone-300',
} as const;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-PE', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date);
---

<Layout title="Visión y Desarrollo para Pontó | Pukapacha">
  <main class="min-h-screen overflow-hidden bg-stone-50 text-stone-900">
    <!-- HERO SECTION: Tonos tierra colorada, arcilla y cobrizos -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-[#240c07] via-[#4d190f] to-[#7c2b1a] text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_15%,rgba(249,115,22,0.22),transparent_35%),linear-gradient(135deg,rgba(36,14,8,0.92),transparent_65%)]"></div>
      <div class="absolute -right-32 top-24 h-96 w-96 rounded-full border border-amber-400/20 bg-amber-500/10 blur-3xl"></div>
      
      <div class="relative mx-auto grid min-h-[680px] max-w-7xl items-center gap-12 px-5 pb-36 pt-28 sm:px-8 lg:grid-cols-[1.08fr_0.92fr] lg:px-10">
        <div class="max-w-3xl">
          <!-- Texto pequeño requerido: 'Visión y Desarrollo para Pontó' -->
          <p class="mb-6 flex items-center gap-3 text-xs font-black uppercase tracking-[0.28em] text-amber-300">
            <span class="h-px w-10 bg-amber-400"></span>Visión y Desarrollo para Pontó
          </p>
          <!-- Título principal INTACTO -->
          <h1 class="text-5xl font-black leading-[0.98] tracking-tight drop-shadow-2xl sm:text-7xl lg:text-8xl">
            Un distrito con <span class="bg-gradient-to-r from-amber-200 via-orange-300 to-amber-500 bg-clip-text text-transparent">historia</span>, visión y futuro.
          </h1>
          <p class="mt-7 max-w-2xl text-base leading-8 text-stone-200 sm:text-xl">
            Plataforma comunitaria de Pontó, la histórica tierra colorada (<span class="font-bold text-amber-300">Pukapacha</span>). Unimos la voz de nuestros caseríos para forjar un desarrollo participativo, transparente y con identidad.
          </p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a href="#propuestas" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 px-6 py-4 text-sm font-black text-stone-950 shadow-xl shadow-orange-950/40 transition-all hover:-translate-y-1 hover:brightness-110 focus:outline-2 focus:outline-offset-4 focus:outline-amber-400">
              Conoce las Propuestas <span aria-hidden="true">&#8595;</span>
            </a>
            <a href="#identidad" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/10 px-6 py-4 text-sm font-black text-white shadow-lg backdrop-blur-md transition-all hover:-translate-y-1 hover:border-amber-300 hover:text-amber-200 focus:outline-2 focus:outline-offset-4 focus:outline-amber-400">
              Identidad Pukapacha <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-md lg:justify-self-end">
          <div class="absolute -right-5 -top-5 h-32 w-32 rounded-tr-[2rem] border-r-2 border-t-2 border-amber-400/60"></div>
          <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-amber-400/30 bg-gradient-to-b from-orange-600 via-[#822c1b] to-[#250d07] shadow-2xl shadow-black/50" role="img" aria-label="Paisaje de la tierra colorada de Pontó">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_65%_20%,rgba(255,255,255,0.35),transparent_22%),linear-gradient(155deg,transparent_35%,rgba(58,18,10,0.2)_36%,rgba(28,9,4,0.9)_100%)]"></div>
            <div class="absolute bottom-0 left-0 right-0 p-7 sm:p-9">
              <span class="inline-flex rounded-full bg-amber-400/20 px-3 py-1 text-xs font-black uppercase tracking-[0.2em] text-amber-200 backdrop-blur-md">Pukapacha</span>
              <p class="mt-3 text-2xl font-black leading-tight text-white drop-shadow-lg">Tierra colorada, memoria viva y comunidades unidas.</p>
              <p class="mt-2 text-xs font-medium text-stone-300">Huari · Áncash · Perú</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 1: IDENTIDAD -->
    <section id="identidad" class="relative z-20 -mt-16 px-5 pb-20 sm:px-8 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-xl shadow-stone-900/5 sm:p-12">
          <div class="max-w-3xl">
            <p class="text-xs font-black uppercase tracking-[0.22em] text-orange-800">Raíces y Territorio</p>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-stone-950 sm:text-4xl">
              Identidad Pukapacha: La fuerza de nuestra tierra colorada
            </h2>
            <p class="mt-4 text-base leading-7 text-stone-600">
              Pontó recibe en su tradición quechua el nombre de <strong class="text-stone-900">Pukapacha</strong> debido al característico color rojizo de sus cerros y tierras agrícolas. Este suelo fértil no solo nutre nuestros cultivos, sino también la historia de un pueblo solidario que avanza con dignidad.
            </p>
          </div>

          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-2xl border border-orange-100 bg-[#fdf9f7] p-6 transition-all hover:-translate-y-1 hover:border-orange-300 hover:shadow-lg">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-100 text-orange-800">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 0 1 2 2v1a2 2 0 0 0 2 2 2 2 0 0 1 2 2v2.945M8 3.935V5.5A2.5 2.5 0 0 0 10.5 8h.5a2 2 0 0 1 2 2 2 2 0 1 0 4 0 2 2 0 0 1 2-2h1.064M15 20.488V18a2 2 0 0 1 2-2h3.064M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
              </div>
              <h3 class="mt-4 text-lg font-black text-stone-950">Suelos de Altura</h3>
              <p class="mt-2 text-sm leading-6 text-stone-600">Valles y laderas ricas en arcilla y nutrientes que acogen a familias agricultoras a más de 3,100 m s.n.m.</p>
            </div>

            <div class="rounded-2xl border border-orange-100 bg-[#fdf9f7] p-6 transition-all hover:-translate-y-1 hover:border-orange-300 hover:shadow-lg">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-amber-900">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 0 0-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 0 1 5.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 0 1 9.288 0M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM7 10a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"/></svg>
              </div>
              <h3 class="mt-4 text-lg font-black text-stone-950">Ayni y Minka</h3>
              <p class="mt-2 text-sm leading-6 text-stone-600">Trabajo colectivo en faenas comunales donde cada mano cuenta para abrir caminos y limpiar acequias.</p>
            </div>

            <div class="rounded-2xl border border-orange-100 bg-[#fdf9f7] p-6 transition-all hover:-translate-y-1 hover:border-orange-300 hover:shadow-lg">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-100 text-red-900">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918"/></svg>
              </div>
              <h3 class="mt-4 text-lg font-black text-stone-950">Cultura Quechua</h3>
              <p class="mt-2 text-sm leading-6 text-stone-600">Música de cuerdas, cantos en quechua y festividades que preservan la memoria viva de nuestras generaciones.</p>
            </div>

            <div class="rounded-2xl border border-orange-100 bg-[#fdf9f7] p-6 transition-all hover:-translate-y-1 hover:border-orange-300 hover:shadow-lg">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-stone-200 text-stone-800">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>
              </div>
              <h3 class="mt-4 text-lg font-black text-stone-950">Vocación Agraria</h3>
              <p class="mt-2 text-sm leading-6 text-stone-600">Papas nativas, cereales andinos y ganadería tradicional cultivados con respeto al equilibrio natural.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2: PROPUESTAS -->
    <section id="propuestas" class="bg-white px-5 py-16 sm:px-8 sm:py-24 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <p class="text-xs font-black uppercase tracking-[0.22em] text-orange-800">Plan Estratégico Comunitario</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-stone-950 sm:text-4xl">
            Propuestas para la Transformación de Pontó
          </h2>
          <p class="mt-4 text-base leading-7 text-stone-600">
            Ejes de acción prioritarios formulados desde las necesidades reales de los comuneros y productores para construir un distrito con igualdad de oportunidades.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2">
          <!-- Propuesta 1 -->
          <div class="relative overflow-hidden rounded-2xl border border-stone-200 bg-[#faf6f3] p-8 shadow-sm transition-all hover:border-orange-300 hover:shadow-md">
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-orange-700 text-lg font-black text-white">01</span>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-orange-800">Agua y Agricultura</span>
                <h3 class="text-xl font-black text-stone-950">Siembra de Agua y Riego Tecnificado</h3>
              </div>
            </div>
            <p class="mt-4 text-sm leading-6 text-stone-600">
              Construcción de reservorios comunales y revestimiento de canales para asegurar agua permanente en épocas de estiaje, triplicando la productividad agrícola de nuestras parcelas.
            </p>
            <ul class="mt-4 space-y-2 text-xs font-semibold text-stone-700">
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-orange-700"></span>Cosecha de agua en cabeceras de cuenca.</li>
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-orange-700"></span>Asistencia técnica para cultivos orgánicos.</li>
            </ul>
          </div>

          <!-- Propuesta 2 -->
          <div class="relative overflow-hidden rounded-2xl border border-stone-200 bg-[#faf6f3] p-8 shadow-sm transition-all hover:border-orange-300 hover:shadow-md">
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-700 text-lg font-black text-white">02</span>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-amber-800">Vías e Integración</span>
                <h3 class="text-xl font-black text-stone-950">Conectividad y Mantenimiento de Caminos</h3>
              </div>
            </div>
            <p class="mt-4 text-sm leading-6 text-stone-600">
              Plan continuo de transitabilidad para caminos de herradura y trochas carrozables que unen a Pontó con San Marcos, Huaytuna y los principales centros de comercio provincial.
            </p>
            <ul class="mt-4 space-y-2 text-xs font-semibold text-stone-700">
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-amber-700"></span>Mantenimiento preventivo antes de temporada de lluvias.</li>
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-amber-700"></span>Transporte seguro para escolares y emergencias.</li>
            </ul>
          </div>

          <!-- Propuesta 3 -->
          <div class="relative overflow-hidden rounded-2xl border border-stone-200 bg-[#faf6f3] p-8 shadow-sm transition-all hover:border-orange-300 hover:shadow-md">
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-800 text-lg font-black text-white">03</span>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-red-900">Juventud y Formación</span>
                <h3 class="text-xl font-black text-stone-950">Educación Técnica e Inclusión Digital</h3>
              </div>
            </div>
            <p class="mt-4 text-sm leading-6 text-stone-600">
              Espacios comunales con conectividad a internet de alta velocidad, talleres técnicos productivos y becas comunitarias para que los jóvenes lideren el progreso de Pontó.
            </p>
            <ul class="mt-4 space-y-2 text-xs font-semibold text-stone-700">
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-red-800"></span>Centro digital comunitario de acceso libre.</li>
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-red-800"></span>Formación técnica en agroindustria y gestión local.</li>
            </ul>
          </div>

          <!-- Propuesta 4 -->
          <div class="relative overflow-hidden rounded-2xl border border-stone-200 bg-[#faf6f3] p-8 shadow-sm transition-all hover:border-orange-300 hover:shadow-md">
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-stone-800 text-lg font-black text-white">04</span>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-stone-700">Salud y Saneamiento</span>
                <h3 class="text-xl font-black text-stone-950">Salud Rural y Agua Segura</h3>
              </div>
            </div>
            <p class="mt-4 text-sm leading-6 text-stone-600">
              Mejoramiento de postas de salud con personal médico permanente, botiquines comunales y cloración constante de sistemas de agua para erradicar la anemia infantil.
            </p>
            <ul class="mt-4 space-y-2 text-xs font-semibold text-stone-700">
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-stone-800"></span>Campañas médicas descentralizadas en caseríos.</li>
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-stone-800"></span>Vigilancia comunitaria de la calidad del agua potable.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3: DIAGNÓSTICO -->
    <section id="diagnostico" class="border-y border-stone-200 bg-[#f7f2ee] px-5 py-16 sm:px-8 sm:py-24 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.22em] text-orange-800">Transparencia y Seguimiento</p>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-stone-950 sm:text-4xl">
              Diagnóstico Territorial y Obras Clave
            </h2>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-600">
              Monitoreo del avance de los proyectos de infraestructura y necesidades prioritarias identificadas en las asambleas del distrito.
            </p>
          </div>
          <a href="/obras/" class="inline-flex items-center gap-2 text-sm font-black text-orange-800 transition-colors hover:text-orange-950">
            Ver todas las obras registradas <span aria-hidden="true">&#8594;</span>
          </a>
        </div>

        <!-- Indicadores territoriales -->
        <div class="mb-10 grid gap-4 sm:grid-cols-3">
          <div class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-stone-500">Prioridad Hídrica</p>
            <p class="mt-2 text-2xl font-black text-orange-800">8 Comunidades</p>
            <p class="mt-1 text-xs text-stone-500">En evaluación para reservorios y canales.</p>
          </div>
          <div class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-stone-500">Caminos Rurales</p>
            <p class="mt-2 text-2xl font-black text-amber-800">42 Kilómetros</p>
            <p class="mt-1 text-xs text-stone-500">De vías que requieren mantenimiento periódico.</p>
          </div>
          <div class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-stone-500">Participación Activa</p>
            <p class="mt-2 text-2xl font-black text-stone-800">100% Comunal</p>
            <p class="mt-1 text-xs text-stone-500">Decisiones articuladas con las bases sociales.</p>
          </div>
        </div>

        <!-- Listado de Obras con paleta cálida de tierra colorada -->
        <div class="grid gap-6 md:grid-cols-3">
          {obrasDestacadas.map((obra) => {
            const avance = progresoPorEstado[obra.data.estado];
            return (
              <article class="group overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-md transition-all hover:-translate-y-2 hover:border-orange-300 hover:shadow-xl">
                <div class="relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-[#3b150c] to-[#742718]">
                  <img
                    src={obra.data.imagen}
                    alt={`Imagen de ${obra.data.titulo}`}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-stone-950/60 via-transparent to-transparent"></div>
                  <span class={`absolute left-4 top-4 rounded-full px-3 py-1 text-xs font-black capitalize shadow-lg ring-1 ${estadoStyles[obra.data.estado]}`}>
                    {obra.data.estado}
                  </span>
                </div>
                <div class="p-6">
                  <time datetime={obra.data.fecha.toISOString()} class="text-xs font-bold uppercase tracking-[0.14em] text-stone-400">
                    {formatDate(obra.data.fecha)}
                  </time>
                  <h3 class="mt-3 text-xl font-black leading-tight text-stone-950">{obra.data.titulo}</h3>
                  <p class="mt-3 line-clamp-2 text-sm leading-6 text-stone-600">{obra.data.descripcion}</p>
                  <div class="mt-6">
                    <div class="mb-2 flex items-center justify-between text-xs font-black text-stone-600">
                      <span>Avance de proyecto</span>
                      <span class="text-orange-800">{avance}%</span>
                    </div>
                    <div class="h-2 overflow-hidden rounded-full bg-stone-200">
                      <div class="h-full rounded-full bg-gradient-to-r from-orange-600 via-amber-600 to-amber-500" style={`width: ${avance}%`}></div>
                    </div>
                  </div>
                  <a
                    href="/obras/"
                    class="mt-6 inline-flex items-center gap-2 rounded-lg border border-orange-800 px-4 py-2.5 text-sm font-black text-orange-900 transition-all hover:bg-orange-800 hover:text-white focus:outline-2 focus:outline-offset-4 focus:outline-orange-700"
                  >
                    Ver Ficha Técnica <span aria-hidden="true">&#8599;</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- SECCIÓN 4: PARTICIPA -->
    <section id="participa" class="relative overflow-hidden bg-gradient-to-br from-[#240c07] via-[#43150b] to-[#6e2315] px-5 py-20 text-white sm:px-8 sm:py-28 lg:px-10">
      <div class="absolute -left-20 bottom-0 h-80 w-80 rounded-full border border-amber-400/10 bg-amber-500/5 blur-3xl"></div>
      <div class="relative mx-auto max-w-7xl">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.24em] text-amber-300">Construyamos Juntos</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight drop-shadow sm:text-5xl">
              Participa en la Visión de Pontó
            </h2>
            <p class="mt-5 text-base leading-8 text-stone-200 sm:text-lg">
              La plataforma comunitaria Pukapacha está abierta a cada vecino, comunero, joven y residente de Pontó. Tus aportes enriquecen las propuestas y fortalecen la agenda de desarrollo de nuestro pueblo.
            </p>

            <div class="mt-8 space-y-4">
              <div class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-400 text-stone-950 font-black">1</span>
                <div>
                  <h4 class="font-bold text-amber-200">Asambleas y Diálogo Comunal</h4>
                  <p class="text-xs leading-5 text-stone-300">Coordinación directa con los delegados y directivas comunales de cada sector.</p>
                </div>
              </div>
              <div class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-400 text-stone-950 font-black">2</span>
                <div>
                  <h4 class="font-bold text-amber-200">Red de Pontoninos Residentes</h4>
                  <p class="text-xs leading-5 text-stone-300">Canal de articulación para paisanos residentes en Huaraz, Lima y el exterior.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Formulario de Participación Ciudadana -->
          <div class="rounded-3xl border border-amber-400/20 bg-stone-900/90 p-8 shadow-2xl backdrop-blur-md">
            <h3 class="text-xl font-black text-white">Envía tu Propuesta o Iniciativa</h3>
            <p class="mt-1 text-xs text-stone-400">Sumemos ideas para el agua, los caminos, la educación y el bienestar de Pontó.</p>

            <form class="mt-6 space-y-4" onsubmit="event.preventDefault(); document.getElementById('msg-exito').classList.remove('hidden'); this.reset();">
              <div>
                <label for="nombre" class="block text-xs font-bold uppercase tracking-wider text-stone-300">Nombre o Colectivo Comunal</label>
                <input
                  type="text"
                  id="nombre"
                  required
                  placeholder="Ej. Familia Ramírez / Asociación de Productores"
                  class="mt-1.5 w-full rounded-xl border border-stone-700 bg-stone-800/80 px-4 py-3 text-sm text-white placeholder-stone-500 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
                />
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="comunidad" class="block text-xs font-bold uppercase tracking-wider text-stone-300">Caserío o Sector</label>
                  <select
                    id="comunidad"
                    class="mt-1.5 w-full rounded-xl border border-stone-700 bg-stone-800 px-3.5 py-3 text-sm text-white focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
                  >
                    <option value="ponto-centro">Pontó Centro</option>
                    <option value="san-marcos">San Marcos</option>
                    <option value="huaytuna">Huaytuna</option>
                    <option value="utcubamba">Utcubamba</option>
                    <option value="yauya">Yauya</option>
                    <option value="residentes">Residente en otra ciudad</option>
                    <option value="otro">Otro sector</option>
                  </select>
                </div>
                <div>
                  <label for="eje" class="block text-xs font-bold uppercase tracking-wider text-stone-300">Eje de Propuesta</label>
                  <select
                    id="eje"
                    class="mt-1.5 w-full rounded-xl border border-stone-700 bg-stone-800 px-3.5 py-3 text-sm text-white focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
                  >
                    <option value="agua">Agua y Riego Tecnificado</option>
                    <option value="caminos">Caminos y Conectividad</option>
                    <option value="educacion">Educación y Juventud</option>
                    <option value="salud">Salud y Calidad de Vida</option>
                    <option value="identidad">Identidad y Cultura</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="detalle" class="block text-xs font-bold uppercase tracking-wider text-stone-300">Detalle de tu Propuesta</label>
                <textarea
                  id="detalle"
                  rows="3"
                  required
                  placeholder="Describe la necesidad o idea de mejora para tu sector..."
                  class="mt-1.5 w-full rounded-xl border border-stone-700 bg-stone-800/80 px-4 py-3 text-sm text-white placeholder-stone-500 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full rounded-xl bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 py-3.5 text-sm font-black uppercase tracking-wider text-stone-950 shadow-lg shadow-orange-950/50 transition-all hover:brightness-110 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400"
              >
                Aportar Propuesta a la Visión
              </button>

              <div id="msg-exito" class="hidden rounded-xl border border-amber-400/40 bg-amber-400/10 p-3 text-center text-xs font-bold text-amber-300">
                ✓ ¡Muchas gracias! Tu propuesta ha sido registrada para ser integrada a la plataforma comunitaria de Pontó.
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
