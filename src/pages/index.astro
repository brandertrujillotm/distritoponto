---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pontó: Tierra Colorada, Futuro en Construcción | Pukapacha">
  <main class="min-h-screen bg-[#faf6f2] text-stone-900">
    <!-- BLOQUE 1: Hero Section (Impacto Visual) -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-[#200a05] via-[#45160c] to-[#782918] px-5 pb-24 pt-24 text-white sm:px-8 sm:pb-32 sm:pt-32 lg:px-10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_25%,rgba(249,115,22,0.24),transparent_42%),linear-gradient(135deg,rgba(32,10,5,0.96),transparent_65%)]"></div>
      <div class="absolute -right-24 top-20 h-96 w-96 rounded-full border border-amber-400/20 bg-amber-500/10 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <!-- Etiqueta superior (Badge) exacta -->
          <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/30 bg-amber-400/10 px-4 py-1.5 text-xs font-black uppercase tracking-[0.22em] text-amber-300 backdrop-blur-md">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
            Visión y Desarrollo para nuestro Distrito
          </span>

          <!-- Título Principal exacto -->
          <h1 class="mt-6 text-4xl font-black leading-[1.02] tracking-tight drop-shadow-2xl sm:text-6xl lg:text-7xl">
            Pontó: <span class="bg-gradient-to-r from-amber-200 via-orange-300 to-amber-500 bg-clip-text text-transparent">Tierra Colorada</span>, Futuro en Construcción.
          </h1>

          <!-- Subtítulo exacto -->
          <p class="mt-6 max-w-2xl text-base leading-8 text-stone-200 sm:text-lg sm:leading-8">
            Desde las aguas del río Puchca hasta las alturas de Parashapampa, somos un distrito de herencia milenaria. Esta es una plataforma ciudadana dedicada a proponer soluciones técnicas y reales para nuestros 15 anexos.
          </p>

          <!-- Botones (Call to Action) exactos -->
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <!-- Botón Principal (Relleno terracota): 'Ver Propuestas' (Enlace a /propuestas) -->
            <a
              href="/propuestas"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-500 via-orange-600 to-[#b4432a] px-7 py-4 text-sm font-black text-stone-950 shadow-xl shadow-orange-950/40 transition-all duration-300 hover:-translate-y-1 hover:brightness-110 focus:outline-2 focus:outline-offset-4 focus:outline-amber-400"
            >
              Ver Propuestas <span aria-hidden="true">&rarr;</span>
            </a>

            <!-- Botón Secundario (Borde terracota): 'Nuestro Diagnóstico' (Enlace a /diagnostico) -->
            <a
              href="/diagnostico"
              class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-amber-400/60 bg-white/5 px-7 py-4 text-sm font-black text-white backdrop-blur-md shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-amber-300 hover:bg-white/10 hover:text-amber-200 focus:outline-2 focus:outline-offset-4 focus:outline-amber-400"
            >
              Nuestro Diagnóstico <span aria-hidden="true">&#8595;</span>
            </a>
          </div>
        </div>

        <!-- Portada visual con mural representativo y datos clave -->
        <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
          <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-orange-500/25 via-amber-400/20 to-red-500/25 blur-xl"></div>
          <div class="relative overflow-hidden rounded-3xl border-2 border-amber-400/30 bg-stone-950 shadow-2xl">
            <div class="relative aspect-[4/3] w-full overflow-hidden">
              <img
                src="/images/ponto-arte-identidad.jpg"
                alt="Paisaje cultural y muralismo en la tierra colorada de Pontó"
                class="h-full w-full object-cover transition duration-700 hover:scale-105"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/25 to-transparent"></div>
              
              <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
                <span class="inline-flex rounded-full bg-amber-400/20 px-3 py-1 text-[11px] font-black uppercase tracking-wider text-amber-300 backdrop-blur-md">
                  Pukapacha · Huari, Áncash
                </span>
                <p class="mt-2 text-lg font-black text-white sm:text-xl">
                  De Puchca a Parashapampa: 15 anexos unidos por el progreso.
                </p>
                <div class="mt-3 flex items-center gap-4 text-xs font-semibold text-stone-300">
                  <span>📍 3,100 m s. n. m.</span>
                  <span>🌾 118.29 km²</span>
                  <span>🤝 15 Anexos</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOQUE 2: Nuestros Pilares de Visión (Grilla de 3 Tarjetas) -->
    <section class="relative z-20 -mt-10 px-5 pb-20 sm:px-8 sm:pb-28 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 text-center sm:text-left">
          <span class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-[#fbf3ee] px-3.5 py-1 text-xs font-black uppercase tracking-wider text-[#8c2d19]">
            <span class="h-2 w-2 rounded-full bg-orange-600"></span>
            Ejes Estratégicos
          </span>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            Nuestros Pilares de Visión
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-7 text-stone-600">
            Compromisos centrales para transformar el potencial productivo, social y cultural de nuestro distrito.
          </p>
        </div>

        <div class="grid gap-7 md:grid-cols-3">
          <!-- Tarjeta 1: Agua y Agricultura -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-8">
            <div class="absolute right-0 top-0 h-28 w-28 translate-x-8 -translate-y-8 rounded-full bg-orange-100/40 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono: Gota de agua o planta -->
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-100 via-amber-100 to-orange-200 text-[#8c2d19] shadow-inner transition duration-300 group-hover:scale-110">
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a7.5 7.5 0 0 0 7.5-7.5c0-4.14-7.5-11.25-7.5-11.25S4.5 9.36 4.5 13.5A7.5 7.5 0 0 0 12 21Z" />
                  </svg>
                </div>
                <span class="rounded-full border border-orange-200/80 bg-[#fdf5f0] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#8c2d19]">
                  Pilar 01
                </span>
              </div>

              <!-- Título exacto -->
              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                Agua y Agricultura
              </h3>

              <!-- Texto exacto -->
              <p class="mt-3 text-sm leading-7 text-stone-600 sm:text-base sm:leading-7">
                Impulsamos la eficiencia hídrica y el riego tecnificado para transformar nuestro minifundio y potenciar desde los frutales de Yunguilla hasta las cosechas de Cuchos.
              </p>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-orange-800">
              <span>Eficiencia hídrica y tecnificación</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- Tarjeta 2: Integración y Conectividad -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-8">
            <div class="absolute right-0 top-0 h-28 w-28 translate-x-8 -translate-y-8 rounded-full bg-amber-100/40 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono: Carretera o puente -->
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-100 via-orange-100 to-amber-200 text-[#7c2d12] shadow-inner transition duration-300 group-hover:scale-110">
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 19 8 5m8 0 4 14M12 5v2m0 5v2m0 5v2" />
                  </svg>
                </div>
                <span class="rounded-full border border-amber-200/80 bg-[#fef8f2] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#7c2d12]">
                  Pilar 02
                </span>
              </div>

              <!-- Título exacto -->
              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                Integración y Conectividad
              </h3>

              <!-- Texto exacto -->
              <p class="mt-3 text-sm leading-7 text-stone-600 sm:text-base sm:leading-7">
                Proponemos el cierre de brechas en infraestructura vial y conectividad digital para unir a San Miguel, Conin y todas nuestras comunidades campesinas.
              </p>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-amber-900">
              <span>Caminos rurales e internet</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- Tarjeta 3: Identidad y Turismo -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-8">
            <div class="absolute right-0 top-0 h-28 w-28 translate-x-8 -translate-y-8 rounded-full bg-red-100/40 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono: Montaña o sol andino -->
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-red-100 via-orange-100 to-red-200 text-[#991b1b] shadow-inner transition duration-300 group-hover:scale-110">
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m3 20 8-14 3.5 6 2.5-4 4 12H3Z" />
                    <circle cx="18" cy="6" r="2.5" />
                  </svg>
                </div>
                <span class="rounded-full border border-red-200/80 bg-[#fdf4f4] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#991b1b]">
                  Pilar 03
                </span>
              </div>

              <!-- Título exacto -->
              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                Identidad y Turismo
              </h3>

              <!-- Texto exacto -->
              <p class="mt-3 text-sm leading-7 text-stone-600 sm:text-base sm:leading-7">
                Revaloramos el Qhapaq Ñan, nuestros petroglifos y el muralismo de la tierra 'pukapachina' como motores de una nueva economía ecoturística.
              </p>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-red-900">
              <span>Qhapaq Ñan y arte comunal</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- BLOQUE 3: Explora nuestra plataforma (Grilla de accesos rápidos a otras páginas) -->
    <section class="border-t border-stone-200/80 bg-white px-5 py-20 sm:px-8 sm:py-28 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center sm:text-left">
          <span class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-[#fbf3ee] px-3.5 py-1 text-xs font-black uppercase tracking-wider text-[#8c2d19]">
            <span class="h-2 w-2 rounded-full bg-orange-600"></span>
            Navegación Rápida
          </span>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            Explora nuestra plataforma
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-7 text-stone-600">
            Conoce a fondo las propuestas técnicas, la memoria histórica de nuestra tierra y súmate a la visión de Pontó.
          </p>
        </div>

        <!-- Grilla tipo Bento / 4 banners interactivos -->
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Banner 1: Conoce nuestra Identidad -->
          <a
            href="/identidad"
            class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-[#fdfaf8] p-7 transition-all duration-300 hover:-translate-y-2 hover:border-orange-400 hover:bg-white hover:shadow-xl hover:shadow-orange-950/10 focus:outline-2 focus:outline-offset-2 focus:outline-orange-400"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-100 text-[#8c2d19] transition duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 1-9-9c0-4.97 4.03-9 9-9 3.5 0 6.54 1.99 8.04 4.91M12 21c4.97 0 9-4.03 9-9 0-1.12-.2-2.19-.58-3.18M12 21V9m0 0a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm0 0a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" />
                </svg>
              </div>
              <h3 class="mt-5 text-xl font-black text-stone-950 group-hover:text-[#8c2d19] transition-colors">
                Conoce nuestra Identidad
              </h3>
              <p class="mt-2 text-sm leading-6 text-stone-600">
                La historia de Pontó Viejo, nuestra resiliencia y cultura.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 text-xs font-black uppercase tracking-wider text-orange-800">
              <span>Explorar</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
            </div>
          </a>

          <!-- Banner 2: Lee el Diagnóstico -->
          <a
            href="/diagnostico"
            class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-[#fdfaf8] p-7 transition-all duration-300 hover:-translate-y-2 hover:border-amber-400 hover:bg-white hover:shadow-xl hover:shadow-orange-950/10 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-[#7c2d12] transition duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                </svg>
              </div>
              <h3 class="mt-5 text-xl font-black text-stone-950 group-hover:text-[#7c2d12] transition-colors">
                Lee el Diagnóstico
              </h3>
              <p class="mt-2 text-sm leading-6 text-stone-600">
                Un análisis real de las necesidades de nuestro territorio.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 text-xs font-black uppercase tracking-wider text-amber-900">
              <span>Explorar</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
            </div>
          </a>

          <!-- Banner 3: Descubre las Propuestas -->
          <a
            href="/propuestas"
            class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-[#fdfaf8] p-7 transition-all duration-300 hover:-translate-y-2 hover:border-red-400 hover:bg-white hover:shadow-xl hover:shadow-orange-950/10 focus:outline-2 focus:outline-offset-2 focus:outline-red-400"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-100 text-[#991b1b] transition duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.439a8.966 8.966 0 0 1-4.5 0m4.5 0v1.5a1.5 1.5 0 0 1-1.5 1.5h-1.5a1.5 1.5 0 0 1-1.5-1.5v-1.5m3.75-9.75a6 6 0 1 0-7.5 0" />
                </svg>
              </div>
              <h3 class="mt-5 text-xl font-black text-stone-950 group-hover:text-[#991b1b] transition-colors">
                Descubre las Propuestas
              </h3>
              <p class="mt-2 text-sm leading-6 text-stone-600">
                Proyectos viables para el desarrollo de Áncash.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 text-xs font-black uppercase tracking-wider text-red-900">
              <span>Explorar</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
            </div>
          </a>

          <!-- Banner 4: Suma tu Voz (Destacado Terracota) -->
          <a
            href="/participa"
            class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-orange-400/40 bg-gradient-to-br from-[#240c07] via-[#45160c] to-[#782918] p-7 text-white transition-all duration-300 hover:-translate-y-2 hover:border-amber-400 hover:shadow-2xl hover:shadow-orange-950/40 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-400/20 text-amber-300 backdrop-blur-md transition duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" />
                </svg>
              </div>
              <h3 class="mt-5 text-xl font-black text-white group-hover:text-amber-300 transition-colors">
                Suma tu Voz
              </h3>
              <p class="mt-2 text-sm leading-6 text-stone-200">
                Participa y envíanos las necesidades de tu caserío.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 text-xs font-black uppercase tracking-wider text-amber-300">
              <span>Participar</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
