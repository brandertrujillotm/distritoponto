---
import Layout from '../layouts/Layout.astro';

const anexos = [
  'Rambrán',
  'Cuchos',
  'Recrish',
  'Tinco',
  'San Juan',
  'Gagawain',
  'Palca',
  'Pontó Viejo',
  'Culluchaca',
  'Yunguilla',
  'San Jorge',
  'Poyomonte',
  'Pontó',
  'San Antonio',
  'Parashapampa',
];
---

<Layout title="Pontó: Herencia, Resiliencia y Futuro | Pukapacha">
  <main class="min-h-screen bg-[#faf6f2] text-stone-900">
    <!-- HERO SECTION: Minimalista, visual y con la paleta Pukapacha -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-[#240c07] via-[#4d190f] to-[#7c2b1a] px-5 pb-24 pt-24 text-white sm:px-8 sm:pb-32 sm:pt-32 lg:px-10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(249,115,22,0.22),transparent_42%),linear-gradient(135deg,rgba(36,14,8,0.95),transparent_65%)]"></div>
      <div class="absolute -right-24 top-20 h-80 w-80 rounded-full border border-amber-400/20 bg-amber-500/10 blur-3xl"></div>
      
      <div class="relative mx-auto max-w-4xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/30 bg-amber-400/10 px-4 py-1.5 text-xs font-black uppercase tracking-[0.24em] text-amber-300 backdrop-blur-md">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
          Identidad Pukapacha
        </span>
        
        <!-- TÍTULO PRINCIPAL (Hero Section) exacto -->
        <h1 class="mt-6 text-4xl font-black tracking-tight drop-shadow-2xl sm:text-6xl lg:text-7xl">
          Pontó: Herencia, Resiliencia y Futuro
        </h1>
        
        <!-- SUBTÍTULO exacto -->
        <p class="mx-auto mt-6 max-w-3xl text-base leading-8 text-stone-200 sm:text-xl sm:leading-9">
          Enclavado en el Callejón de Conchucos, nuestro distrito es un ecosistema donde la historia milenaria y la tenacidad humana convergen. Conoce el alma de nuestra tierra.
        </p>

        <div class="mt-8 flex justify-center gap-3">
          <a
            href="#cuadricula"
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 px-5 py-3 text-sm font-black text-stone-950 shadow-lg shadow-orange-950/40 transition hover:brightness-110 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400"
          >
            Explorar Identidad <span aria-hidden="true">&#8595;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 1: Cuadrícula de Identidad (Bento Grid / 4 Tarjetas con Íconos) -->
    <section id="cuadricula" class="relative z-20 -mt-12 px-5 pb-20 sm:px-8 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 text-center sm:text-left">
          <p class="text-xs font-black uppercase tracking-[0.22em] text-[#8c2d19]">Pilares Fundamentales</p>
          <h2 class="mt-1 text-2xl font-black tracking-tight text-stone-950 sm:text-3xl">
            Cuadrícula de Identidad
          </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-2">
          <!-- Tarjeta 1: El Origen del Nombre -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-9">
            <div class="absolute right-0 top-0 h-28 w-28 translate-x-8 -translate-y-8 rounded-full bg-orange-100/40 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono: Hoja / Flor -->
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-100 via-amber-100 to-orange-200 text-[#8c2d19] shadow-inner transition duration-300 group-hover:scale-110">
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 1-9-9c0-4.97 4.03-9 9-9 3.5 0 6.54 1.99 8.04 4.91M12 21c4.97 0 9-4.03 9-9 0-1.12-.2-2.19-.58-3.18M12 21V9m0 0a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm0 0a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" />
                  </svg>
                </div>
                <span class="rounded-full border border-orange-200/80 bg-[#fdf5f0] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#8c2d19]">
                  Etimología
                </span>
              </div>
              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                El Origen del Nombre
              </h3>
              <p class="mt-3 text-sm leading-7 text-stone-600 sm:text-base sm:leading-7">
                Una dualidad histórica. Del quechua puntuu ("planta en floración"), que refleja nuestra conexión con la tierra, y de la palabra hispana "Punta", por la geografía rocosa de nuestro primer asentamiento.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-orange-800">
              <span>Raíz quechua y geográfica</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- Tarjeta 2: Resiliencia Inquebrantable -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-9">
            <div class="absolute right-0 top-0 h-28 w-28 translate-x-8 -translate-y-8 rounded-full bg-amber-100/40 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono: Montaña / Escudo -->
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-100 via-orange-100 to-amber-200 text-[#7c2d12] shadow-inner transition duration-300 group-hover:scale-110">
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m3 20 8-14 3.5 6 2.5-4 4 12H3Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.5 10.5 2.5 3.5 3-2" />
                  </svg>
                </div>
                <span class="rounded-full border border-amber-200/80 bg-[#fef8f2] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#7c2d12]">
                  Fortaleza
                </span>
              </div>
              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                Resiliencia Inquebrantable
              </h3>
              <p class="mt-3 text-sm leading-7 text-stone-600 sm:text-base sm:leading-7">
                Tras la destrucción de Pontó Viejo por un catastrófico aluvión, nuestros antepasados demostraron una tenacidad única al reconstruir nuestro hogar en una meseta segura a más de 3,100 m s. n. m.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-amber-900">
              <span>Meseta andina segura</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- Tarjeta 3: Legado Arqueológico -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-9">
            <div class="absolute right-0 top-0 h-28 w-28 translate-x-8 -translate-y-8 rounded-full bg-red-100/40 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono: Ruina ancestral / Monolito -->
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-red-100 via-orange-100 to-red-200 text-[#991b1b] shadow-inner transition duration-300 group-hover:scale-110">
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 21h16M5 17h14M6 13h12M7 9h10M8 5h8M10 2h4" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 21V9m10 12V9" />
                  </svg>
                </div>
                <span class="rounded-full border border-red-200/80 bg-[#fdf4f4] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#991b1b]">
                  Historia Viva
                </span>
              </div>
              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                Legado Arqueológico
              </h3>
              <p class="mt-3 text-sm leading-7 text-stone-600 sm:text-base sm:leading-7">
                Más de tres milenios de historia. Albergamos el arte rupestre de Caullumachay (influencia Chavín), fortalezas de piedra en las cumbres y los históricos caminos del Qhapaq Ñan.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-red-900">
              <span>Chavín y Qhapaq Ñan</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- Tarjeta 4: Tradición y Sincretismo -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-9">
            <div class="absolute right-0 top-0 h-28 w-28 translate-x-8 -translate-y-8 rounded-full bg-amber-100/40 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono: Máscara / Instrumento musical -->
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-100 via-orange-100 to-amber-200 text-[#b45309] shadow-inner transition duration-300 group-hover:scale-110">
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2Zm12-3c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2ZM9 10l12-3" />
                  </svg>
                </div>
                <span class="rounded-full border border-amber-200/80 bg-[#fef8f2] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#b45309]">
                  Festividad
                </span>
              </div>
              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                Tradición y Sincretismo
              </h3>
              <p class="mt-3 text-sm leading-7 text-stone-600 sm:text-base sm:leading-7">
                Nuestras calles vibran con San Miguel Arcángel y un Señor de los Milagros andino, acompañado por bandas de bronce y las milenarias coreografías de la Huaridanza.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-amber-900">
              <span>Huaridanza y devoción</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2: Bloque de Visión y Renovación (Dos columnas: Texto + Espacio para Imagen) -->
    <section class="border-t border-stone-200/80 bg-white px-5 py-20 sm:px-8 sm:py-28 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <!-- Columna 1: Texto -->
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-[#fbf3ee] px-3.5 py-1 text-xs font-black uppercase tracking-wider text-[#8c2d19]">
              <span class="h-2 w-2 rounded-full bg-orange-600"></span>
              Visión y Renovación
            </div>
            
            <!-- TÍTULO exacto -->
            <h2 class="mt-4 text-3xl font-black tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
              Pukapacha: Arte y Desarrollo
            </h2>
            
            <!-- TEXTO exacto -->
            <p class="mt-6 text-base leading-8 text-stone-600 sm:text-lg sm:leading-8">
              Hoy, Pontó se renueva. A través del "Festival de Arte con Identidad", nuestros muros de adobe se han convertido en inmensos lienzos públicos que retratan a nuestros comuneros y nuestra cultura. Esta explosión de color en la "tierra colorada" nos proyecta como un enclave de turismo cultural y ecológico en el corazón de Áncash.
            </p>

            <div class="mt-8 flex flex-wrap gap-2.5">
              <span class="rounded-xl border border-stone-200 bg-[#faf6f2] px-3.5 py-2 text-xs font-bold text-stone-800">
                🎨 Murales sobre adobe
              </span>
              <span class="rounded-xl border border-stone-200 bg-[#faf6f2] px-3.5 py-2 text-xs font-bold text-stone-800">
                🌿 Turismo ecológico
              </span>
              <span class="rounded-xl border border-stone-200 bg-[#faf6f2] px-3.5 py-2 text-xs font-bold text-stone-800">
                👥 Participación comunal
              </span>
            </div>

            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
              <a
                href="/propuestas"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 px-6 py-3.5 text-sm font-black text-stone-950 shadow-md shadow-orange-950/20 transition hover:brightness-110 focus:outline-2 focus:outline-offset-2 focus:outline-amber-400"
              >
                Conoce las Propuestas &rarr;
              </a>
              <a
                href="/participa"
                class="inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 bg-white px-6 py-3.5 text-sm font-bold text-stone-800 shadow-sm transition hover:border-orange-400 hover:text-orange-900"
              >
                Sumar mi iniciativa
              </a>
            </div>
          </div>

          <!-- Columna 2: Espacio para Imagen -->
          <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
            <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-orange-500/20 via-amber-400/20 to-red-500/20 blur-xl"></div>
            <div class="relative aspect-[4/3] overflow-hidden rounded-3xl border-2 border-stone-200/90 bg-stone-100 shadow-2xl">
              <img
                src="/images/ponto-arte-identidad.jpg"
                alt="Mural comunal del Festival de Arte con Identidad en Pontó, Áncash"
                class="h-full w-full object-cover transition duration-700 hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-stone-950/70 via-stone-950/10 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
                <span class="inline-flex rounded-full bg-amber-400/20 px-3 py-1 text-[11px] font-black uppercase tracking-wider text-amber-300 backdrop-blur-md">
                  Murales de Pontó
                </span>
                <p class="mt-2 text-lg font-black text-white sm:text-xl">
                  Lienzos de adobe que retratan la memoria viva de nuestra gente
                </p>
                <p class="mt-1 text-xs text-stone-300">
                  Festival de Arte con Identidad · Tierra Colorada (Pukapacha)
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3: Nuestro Territorio (Grilla de 3 columnas: Datos geográficos y políticos) -->
    <section class="border-t border-stone-200/80 bg-[#fbf7f4] px-5 py-20 sm:px-8 sm:py-28 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center sm:text-left">
          <span class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-[#fbf3ee] px-3.5 py-1 text-xs font-black uppercase tracking-wider text-[#8c2d19]">
            <span class="h-2 w-2 rounded-full bg-orange-600"></span>
            Geografía y Organización Política
          </span>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            Nuestro Territorio
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-7 text-stone-600">
            Dimensiones, límites territoriales e integración comunal del distrito de Pontó en la provincia de Huari.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          <!-- COLUMNA 1: Ubicación y Extensión -->
          <article class="flex flex-col justify-between rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-8">
            <div>
              <div class="flex items-center justify-between">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-100 via-amber-100 to-orange-200 text-[#8c2d19] shadow-inner">
                  <!-- Ícono: Mapa o pin de ubicación -->
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                </div>
                <span class="rounded-full border border-orange-200/80 bg-[#fdf5f0] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#8c2d19]">
                  Espacio Físico
                </span>
              </div>

              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                Ubicación y Extensión
              </h3>

              <div class="mt-5 space-y-4">
                <div class="rounded-2xl border border-stone-100 bg-[#fdfaf8] p-4">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Ubicación Principal</p>
                  <p class="mt-1 text-sm font-bold text-stone-900 leading-snug">
                    Margen derecha del río Puchca (Provincia de Huari).
                  </p>
                </div>

                <div class="rounded-2xl border border-stone-100 bg-[#fdfaf8] p-4">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Coordenadas</p>
                  <p class="mt-1 font-mono text-sm font-bold text-[#8c2d19]">
                    18 L 0279932 | UTM 8968475.
                  </p>
                </div>

                <div class="rounded-2xl border border-stone-100 bg-[#fdfaf8] p-4">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Superficie</p>
                  <p class="mt-1 text-sm font-bold text-stone-900 leading-snug">
                    <span class="text-base font-black text-[#8c2d19]">118.29 km²</span> (representa el 4.27% del territorio provincial).
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-orange-800">
              <span>Cuenca del Río Puchca</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- COLUMNA 2: Fronteras y Límites -->
          <article class="flex flex-col justify-between rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-8">
            <div>
              <div class="flex items-center justify-between">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-100 via-orange-100 to-amber-200 text-[#7c2d12] shadow-inner">
                  <!-- Ícono: Brújula -->
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" fill-opacity="0.25" />
                  </svg>
                </div>
                <span class="rounded-full border border-amber-200/80 bg-[#fef8f2] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#7c2d12]">
                  Delimitación
                </span>
              </div>

              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                Fronteras y Límites
              </h3>

              <div class="mt-5 space-y-3">
                <div class="flex items-start gap-3 rounded-2xl border border-stone-100 bg-[#fdfaf8] p-3.5">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-orange-100 text-xs font-black text-[#8c2d19]">N</span>
                  <div class="text-xs sm:text-sm">
                    <strong class="font-black text-stone-900">Norte:</strong>
                    <span class="text-stone-600"> Distrito de Aczo (Provincia de Antonio Raymondi).</span>
                  </div>
                </div>

                <div class="flex items-start gap-3 rounded-2xl border border-stone-100 bg-[#fdfaf8] p-3.5">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-xs font-black text-[#7c2d12]">S</span>
                  <div class="text-xs sm:text-sm">
                    <strong class="font-black text-stone-900">Sur:</strong>
                    <span class="text-stone-600"> Distrito de Chana.</span>
                  </div>
                </div>

                <div class="flex items-start gap-3 rounded-2xl border border-stone-100 bg-[#fdfaf8] p-3.5">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-red-100 text-xs font-black text-[#991b1b]">E</span>
                  <div class="text-xs sm:text-sm">
                    <strong class="font-black text-stone-900">Este:</strong>
                    <span class="text-stone-600"> Distrito de Huacachi.</span>
                  </div>
                </div>

                <div class="flex items-start gap-3 rounded-2xl border border-stone-100 bg-[#fdfaf8] p-3.5">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-stone-200 text-xs font-black text-stone-800">O</span>
                  <div class="text-xs sm:text-sm">
                    <strong class="font-black text-stone-900">Oeste:</strong>
                    <span class="text-stone-600"> Distritos de Cajay, Rahuapampa y Huachis.</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-amber-900">
              <span>Articulación territorial</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- COLUMNA 3: División Política -->
          <article class="flex flex-col justify-between rounded-3xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-400/80 hover:shadow-xl hover:shadow-orange-950/5 sm:p-8">
            <div>
              <div class="flex items-center justify-between">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-red-100 via-orange-100 to-red-200 text-[#991b1b] shadow-inner">
                  <!-- Ícono: Edificio o bandera -->
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4" />
                  </svg>
                </div>
                <span class="rounded-full border border-red-200/80 bg-[#fdf4f4] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-[#991b1b]">
                  Pueblos y Caseríos
                </span>
              </div>

              <h3 class="mt-6 text-xl font-black text-stone-950 sm:text-2xl">
                División Política
              </h3>

              <div class="mt-4 space-y-3">
                <div class="rounded-2xl border border-stone-100 bg-[#fdfaf8] p-3.5">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Creación Política</p>
                  <p class="mt-0.5 text-sm font-bold text-stone-900">14 de octubre de 1901.</p>
                </div>

                <div class="rounded-2xl border border-stone-100 bg-[#fdfaf8] p-3.5">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Centros Poblados (2)</p>
                  <div class="mt-1 flex flex-wrap gap-1.5">
                    <span class="inline-flex items-center rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-black text-[#7c2d12]">
                      San Miguel
                    </span>
                    <span class="inline-flex items-center rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-black text-[#7c2d12]">
                      Conin
                    </span>
                  </div>
                </div>

                <div>
                  <p class="text-[11px] font-black uppercase tracking-wider text-[#8c2d19]">Nuestros Anexos (15)</p>
                  <!-- Pills / Etiquetas visuales en tonos terracota / arcilla suave -->
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {anexos.map((anexo) => (
                      <span class="inline-flex items-center rounded-lg border border-orange-200/90 bg-[#faeee7] px-2.5 py-1 text-xs font-bold text-[#8c2d19] shadow-xs transition-all duration-200 hover:scale-105 hover:bg-orange-100 hover:border-orange-300">
                        {anexo}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-6 flex items-center gap-2 border-t border-stone-100 pt-4 text-xs font-black uppercase tracking-wider text-red-900">
              <span>15 anexos y 2 centros poblados</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>

