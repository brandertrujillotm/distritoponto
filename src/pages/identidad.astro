---
import Layout from '../layouts/Layout.astro';

// Datos de Organización Territorial Oficial
const capital = {
  nombre: 'Pontó',
  tipo: 'Capital Distrital',
  altitud: '3,140 m s. n. m.',
  descripcion: 'Sede administrativa, centro cívico, cultural e institucional del distrito de Pontó. Fundada tras la histórica reubicación desde Pontó Viejo sobre una meseta segura y fértil a 3,140 m s. n. m.',
  atributos: ['Sede Municipal', 'Centro Cívico y Parroquial', 'Eje de Servicios Públicos'],
};

const centrosPoblados = [
  {
    nombre: 'San Miguel',
    tipo: 'Centro Poblado',
    descripcion: 'Pilar histórico de organización comunal, dinamismo vecinal y festividad tradicional en la cuenca distrital.',
    zona: 'Cuenca Media',
  },
  {
    nombre: 'Conin',
    tipo: 'Centro Poblado',
    descripcion: 'Eje estratégico de integración social, producción agropecuaria y articulación entre comunidades campesinas.',
    zona: 'Corredor Productivo',
  },
];

const anexos = [
  { nombre: 'Rambrán', detalle: 'Comunidad agrícola' },
  { nombre: 'Cuchos', detalle: 'Zona de sembríos' },
  { nombre: 'Recrish', detalle: 'Caserío tradicional' },
  { nombre: 'Tinco', detalle: 'Confluencia de quebradas' },
  { nombre: 'San Juan', detalle: 'Comunidad andina' },
  { nombre: 'Gagawain', detalle: 'Cumbres y laderas' },
  { nombre: 'Palca', detalle: 'Valle interandino' },
  { nombre: 'Pontó Viejo', detalle: 'Cuna histórica del aluvión' },
  { nombre: 'Culluchaca', detalle: 'Paso y quebrada' },
  { nombre: 'Yunguilla', detalle: 'Valle frutícola' },
  { nombre: 'San Jorge', detalle: 'Sector campesino' },
  { nombre: 'Poyomonte', detalle: 'Colinas fértiles' },
  { nombre: 'San Antonio', detalle: 'Asamblea comunal' },
  { nombre: 'Parashapampa', detalle: 'Altas mesetas' },
];

// Límites cardinales estructurados
const limitesCardinales = [
  {
    rumbo: 'Norte',
    sigla: 'N',
    jurisdiccion: 'Provincia de Antonio Raymondi',
    distrito: 'Distrito de Aczo',
    detalle: 'Frontera septentrional articulada directamente con la vecina provincia raymondina.',
    badgeClass: 'bg-orange-600 text-white',
    cardBorder: 'hover:border-orange-400',
    accentText: 'text-[#8c2d19]',
  },
  {
    rumbo: 'Sur',
    sigla: 'S',
    jurisdiccion: 'Provincia de Huari',
    distrito: 'Distrito de Chana',
    detalle: 'Límite meridional que enlaza con las cuencas altas y valles agropecuarios contiguos.',
    badgeClass: 'bg-amber-600 text-white',
    cardBorder: 'hover:border-amber-400',
    accentText: 'text-[#7c2d12]',
  },
  {
    rumbo: 'Este',
    sigla: 'E',
    jurisdiccion: 'Provincia de Huari',
    distrito: 'Distrito de Huacachi',
    detalle: 'Frontera oriental que se proyecta hacia los cañones y vertientes del río Puchca.',
    badgeClass: 'bg-red-700 text-white',
    cardBorder: 'hover:border-red-400',
    accentText: 'text-[#991b1b]',
  },
  {
    rumbo: 'Oeste',
    sigla: 'O',
    jurisdiccion: 'Provincia de Huari',
    distrito: 'Cajay, Rahuapampa y Huachis',
    detalle: 'Triple confluencia territorial con el corredor vial y productivo del centro de Huari.',
    badgeClass: 'bg-stone-800 text-white',
    cardBorder: 'hover:border-stone-500',
    accentText: 'text-stone-900',
  },
];
---

<Layout
  title="Identidad e Historia de Pontó | Pukapacha · Tierra Colorada"
  description="Conoce la historia, toponimia (Puntuu y Punta), creación del 30 de septiembre de 1943, altitud de 3,140 m s. n. m. y organización política de Pontó, Huari, Áncash."
>
  <div class="min-h-screen bg-[#faf6f2] text-stone-900">
    <!-- BLOQUE 1: HERO DE HISTORIA (Emotivo: Origen del nombre, aluvión y resiliencia) -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-[#200a05] via-[#43150c] to-[#782817] px-5 pb-28 pt-24 text-white sm:px-8 sm:pb-36 sm:pt-32 lg:px-10">
      <!-- Resplandores ambientales cálidos de Tierra Colorada -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(249,115,22,0.24),transparent_45%),linear-gradient(135deg,rgba(32,10,5,0.95),transparent_70%)]"></div>
      <div class="absolute -right-20 top-16 h-80 w-80 rounded-full border border-amber-400/20 bg-amber-500/10 blur-3xl"></div>
      <div class="absolute -left-20 bottom-10 h-72 w-72 rounded-full border border-orange-500/20 bg-orange-600/10 blur-3xl"></div>

      <div class="relative mx-auto max-w-5xl text-center">
        <!-- Badge institucional -->
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/30 bg-amber-400/10 px-4 py-1.5 text-xs font-black uppercase tracking-[0.24em] text-amber-300 backdrop-blur-md">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
          Memoria, Resiliencia y Raíces Vivas
        </span>

        <!-- Título emotivo -->
        <h1 class="mt-6 text-4xl font-black tracking-tight drop-shadow-2xl sm:text-6xl lg:text-7xl">
          <span class="inline-block animate-gradient bg-gradient-to-r from-red-600 via-orange-500 to-amber-500 bg-[length:200%_auto] bg-clip-text text-transparent transition-transform duration-500 hover:scale-105 cursor-default pb-1">
            Renacido de la Tierra Colorada
          </span>
        </h1>

        <!-- Narrativa histórica del aluvión y del origen del nombre -->
        <div class="mx-auto mt-8 max-w-3xl space-y-5 text-base leading-8 text-stone-200 sm:text-lg sm:leading-9">
          <p>
            En la margen derecha del río Puchca, en el corazón de la provincia de Huari, la historia de Pontó une dos orígenes inseparables: la floración fecunda del quechua <strong class="text-amber-300">"Puntuu"</strong> y la firmeza del cerro en <strong class="text-amber-300">"Punta"</strong> que custodiaba a <strong class="text-white">Pontó Viejo</strong>.
          </p>
          <p>
            Cuando un <strong class="text-amber-200">catastrófico aluvión</strong> arrasó por completo aquel antiguo asentamiento, los pobladores encontraron en la adversidad la mayor prueba de su entereza. Guiados por una resiliencia comunal inquebrantable, se reubicaron en una meseta alta y segura a <strong class="text-white">3,140 m s. n. m.</strong>, donde refundaron el <strong class="text-white">Pontó actual</strong>, erigido como capital de esperanza y desarrollo.
          </p>
        </div>

        <!-- Cita emotiva destacada (Glassmorphism) -->
        <div class="mx-auto mt-10 max-w-2xl rounded-2xl border border-amber-400/25 bg-white/5 p-6 backdrop-blur-md sm:p-7">
          <svg class="mx-auto h-8 w-8 text-amber-400/70" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="mt-3 text-sm font-semibold italic text-amber-100 sm:text-base">
            "Del dolor de Pontó Viejo nació la tenacidad del Pontó de hoy: una tierra colorada donde cada muro levantado es testimonio de vida y victoria comunitaria."
          </p>
          <span class="mt-3 block text-xs font-black uppercase tracking-widest text-amber-300">
            — Memoria viva de la Tierra Colorada (Pukapacha)
          </span>
        </div>
      </div>
    </section>

    <!-- BLOQUE 2: TARJETAS DE DATOS (STATS GRID: Creación Oficial, Extensión, División Política y Cuenca) -->
    <section class="relative z-20 -mt-16 px-5 pb-16 sm:px-8 sm:pb-24 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Stat 1: Creación Política Oficial (30 de Septiembre, 1943) -->
          <div class="group flex flex-col justify-between rounded-3xl border border-stone-200/90 bg-white p-7 shadow-xl shadow-stone-900/5 transition-all duration-300 hover:-translate-y-2 hover:border-orange-300 hover:shadow-2xl hover:shadow-orange-950/10">
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-100 text-[#8c2d19] transition-transform duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                </svg>
              </div>
              <p class="mt-5 text-xs font-black uppercase tracking-wider text-[#8c2d19]">Creación Política Oficial</p>
              <h3 class="mt-1 text-2xl font-black tracking-tight text-stone-950">30 de Septiembre</h3>
              <p class="text-lg font-bold text-stone-700">Año 1943</p>
            </div>
            <div class="mt-5 border-t border-stone-100 pt-3 text-xs leading-5 text-stone-500">
              Creado mediante la Ley 9825 en el primer gobierno del <strong>Presidente Manuel Prado Ugarteche</strong>.
            </div>
          </div>

          <!-- Stat 2: Extensión Territorial -->
          <div class="group flex flex-col justify-between rounded-3xl border border-stone-200/90 bg-white p-7 shadow-xl shadow-stone-900/5 transition-all duration-300 hover:-translate-y-2 hover:border-amber-300 hover:shadow-2xl hover:shadow-orange-950/10">
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-[#7c2d12] transition-transform duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934a1.12 1.12 0 0 1-1.006 0L9.503 3.316a1.12 1.12 0 0 0-1.006 0L3.622 5.753C3.24 5.944 3 6.334 3 6.76v12.42c0 .836.88 1.38 1.628 1.006l3.869-1.934c.31-.155.696-.155 1.006 0l4.994 2.497a1.12 1.12 0 0 0 1.006 0Z" />
                </svg>
              </div>
              <p class="mt-5 text-xs font-black uppercase tracking-wider text-[#7c2d12]">Extensión Territorial</p>
              <h3 class="mt-1 text-2xl font-black tracking-tight text-stone-950">118.29 km²</h3>
              <p class="text-sm font-bold text-amber-700">4.27 % de Huari</p>
            </div>
            <div class="mt-5 border-t border-stone-100 pt-3 text-xs leading-5 text-stone-500">
              Superficie que comprende desde valles frutales hasta punas andinas.
            </div>
          </div>

          <!-- Stat 3: División Política (Capital, 2 CC.PP., 14 Anexos) -->
          <div class="group flex flex-col justify-between rounded-3xl border-2 border-orange-300/80 bg-gradient-to-br from-white via-orange-50/20 to-amber-50/40 p-7 shadow-xl shadow-orange-950/5 transition-all duration-300 hover:-translate-y-2 hover:border-orange-500 hover:shadow-2xl hover:shadow-orange-950/15">
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-500 to-red-600 text-white shadow-md transition-transform duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.999-3.199a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                </svg>
              </div>
              <p class="mt-5 text-xs font-black uppercase tracking-wider text-[#8c2d19]">División Política</p>
              <h3 class="mt-1 text-xl font-black tracking-tight text-stone-950 sm:text-2xl">
                Capital: Pontó
              </h3>
              <p class="mt-1 text-sm font-bold text-[#8c2d19]">
                2 CC.PP. + 14 Anexos
              </p>
            </div>
            <div class="mt-5 flex flex-wrap gap-1.5 border-t border-orange-200/60 pt-3 text-[11px] font-bold text-stone-600">
              <span class="rounded bg-orange-100/90 px-1.5 py-0.5 text-[#8c2d19]">1 Capital</span>
              <span class="rounded bg-amber-100/90 px-1.5 py-0.5 text-[#7c2d12]">2 CC.PP.</span>
              <span class="rounded bg-stone-100 px-1.5 py-0.5 text-stone-800">14 Anexos</span>
            </div>
          </div>

          <!-- Stat 4: Ubicación Estratégica -->
          <div class="group flex flex-col justify-between rounded-3xl border border-stone-200/90 bg-white p-7 shadow-xl shadow-stone-900/5 transition-all duration-300 hover:-translate-y-2 hover:border-orange-300 hover:shadow-2xl hover:shadow-orange-950/10">
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-100 text-[#8c2d19] transition-transform duration-300 group-hover:scale-110">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
              </div>
              <p class="mt-5 text-xs font-black uppercase tracking-wider text-[#8c2d19]">Cuenca Geográfica</p>
              <h3 class="mt-1 text-2xl font-black tracking-tight text-stone-950">Río Puchca</h3>
              <p class="text-sm font-bold text-stone-700">Margen Derecha</p>
            </div>
            <div class="mt-5 border-t border-stone-100 pt-3 text-xs leading-5 text-stone-500">
              Parte central de la provincia andina de Huari, Áncash.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOQUE 3: TOPONIMIA E IDENTIDAD DUAL (Diseño de dos tarjetas enfrentadas) -->
    <section class="border-t border-stone-200/80 bg-white px-5 py-20 sm:px-8 sm:py-28 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 text-center sm:text-left">
          <span class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-[#fbf3ee] px-3.5 py-1 text-xs font-black uppercase tracking-wider text-[#8c2d19]">
            <span class="h-2 w-2 rounded-full bg-orange-600"></span>
            Toponimia e Identidad
          </span>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            El Origen del Nombre: Dos Raíces que Forjan Nuestra Identidad
          </h2>
          <p class="mt-3 max-w-3xl text-base leading-7 text-stone-600">
            Nuestra denominación no proviene de una sola vertiente; en Pontó confluyen el legado lingüístico quechua y la memoria viva de la tradición oral que sobrevivió al aluvión.
          </p>
        </div>

        <!-- Dos Tarjetas Enfrentadas: Quechua vs Tradición Oral / Resiliencia -->
        <div class="grid gap-8 md:grid-cols-2">
          <!-- Tarjeta 1: Origen Etimológico Quechua ('Puntuu: Planta en floración') -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border-2 border-emerald-200/80 bg-gradient-to-br from-emerald-50/40 via-white to-orange-50/30 p-8 shadow-md transition-all duration-300 hover:-translate-y-2 hover:border-emerald-400 hover:shadow-2xl sm:p-10">
            <div class="absolute right-0 top-0 h-32 w-32 translate-x-8 -translate-y-8 rounded-full bg-emerald-100/50 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-100 to-amber-100 text-emerald-800 shadow-inner transition-transform duration-300 group-hover:scale-110">
                  <!-- SVG Planta floreciendo -->
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 1-9-9c0-4.97 4.03-9 9-9 3.5 0 6.54 1.99 8.04 4.91M12 21c4.97 0 9-4.03 9-9 0-1.12-.2-2.19-.58-3.18M12 21V9m0 0a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm0 0a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" />
                  </svg>
                </div>
                <span class="rounded-full border border-emerald-300/80 bg-emerald-50 px-3.5 py-1 text-xs font-black uppercase tracking-wider text-emerald-800">
                  Origen Etimológico Quechua
                </span>
              </div>

              <h3 class="mt-6 text-2xl font-black text-stone-950 sm:text-3xl">
                Puntuu: <span class="bg-gradient-to-r from-emerald-700 to-amber-700 bg-clip-text text-transparent">Planta en Floración</span>
              </h3>

              <p class="mt-4 text-base leading-8 text-stone-600 sm:text-lg sm:leading-8">
                En la lengua quechua originaria de nuestros Andes, el vocablo <strong class="text-emerald-950">"Puntuu"</strong> hace referencia directa al momento fértil en que la planta abre sus botones para florecer. Es un tributo directo a la fertilidad de nuestras quebradas, a los campos de cultivo y al ciclo perenne de renovación agraria que sustenta a nuestras familias campesinas.
              </p>

              <div class="mt-6 space-y-2.5">
                <div class="flex items-center gap-2.5 text-xs font-bold text-stone-700">
                  <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-800">✓</span>
                  <span>Símbolo de fertilidad y floración de la tierra</span>
                </div>
                <div class="flex items-center gap-2.5 text-xs font-bold text-stone-700">
                  <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-800">✓</span>
                  <span>Vínculo cósmico ancestral con la agricultura andina</span>
                </div>
              </div>
            </div>

            <div class="mt-8 flex items-center gap-2 border-t border-emerald-100/80 pt-4 text-xs font-black uppercase tracking-wider text-emerald-800">
              <span>Fertilidad y vida en flor</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>

          <!-- Tarjeta 2: Tradición Oral y Resiliencia ('Punta y el aluvión') -->
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border-2 border-orange-300/80 bg-gradient-to-br from-[#fff7ed] via-white to-amber-50/40 p-8 shadow-md transition-all duration-300 hover:-translate-y-2 hover:border-orange-500 hover:shadow-2xl sm:p-10">
            <div class="absolute right-0 top-0 h-32 w-32 translate-x-8 -translate-y-8 rounded-full bg-orange-100/50 blur-2xl transition duration-500 group-hover:scale-150"></div>
            <div>
              <div class="flex items-center justify-between">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-100 via-amber-100 to-orange-200 text-[#8c2d19] shadow-inner transition-transform duration-300 group-hover:scale-110">
                  <!-- SVG Montaña escarpada y fortaleza -->
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m3 20 8-14 3.5 6 2.5-4 4 12H3Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.5 10.5 2.5 3.5 3-2" />
                  </svg>
                </div>
                <span class="rounded-full border border-orange-300/80 bg-orange-50 px-3.5 py-1 text-xs font-black uppercase tracking-wider text-[#8c2d19]">
                  Tradición Oral e Histórica
                </span>
              </div>

              <h3 class="mt-6 text-2xl font-black text-stone-950 sm:text-3xl">
                Punta: <span class="bg-gradient-to-r from-orange-600 to-amber-700 bg-clip-text text-transparent">El Cerro y el Aluvión</span>
              </h3>

              <p class="mt-4 text-base leading-8 text-stone-600 sm:text-lg sm:leading-8">
                La tradición oral y la memoria colectiva guardan el recuerdo del cerro en forma de <strong class="text-[#8c2d19]">"Punta"</strong> situado junto a Pontó Viejo, el cual se mantuvo en pie tras el aluvión destructor. De esa pronunciación derivó el nombre con el que los sobrevivientes rebautizaron su temple, marcando el renacer de un pueblo que erigió en la roca su voluntad de vencer la adversidad.
              </p>

              <div class="mt-6 space-y-2.5">
                <div class="flex items-center gap-2.5 text-xs font-bold text-stone-700">
                  <span class="flex h-5 w-5 items-center justify-center rounded-full bg-orange-100 text-[#8c2d19]">✓</span>
                  <span>Cerro en punta como faro de supervivencia territorial</span>
                </div>
                <div class="flex items-center gap-2.5 text-xs font-bold text-stone-700">
                  <span class="flex h-5 w-5 items-center justify-center rounded-full bg-orange-100 text-[#8c2d19]">✓</span>
                  <span>Memoria de Pontó Viejo y refundación del Pontó actual</span>
                </div>
              </div>
            </div>

            <div class="mt-8 flex items-center gap-2 border-t border-orange-100 pt-4 text-xs font-black uppercase tracking-wider text-orange-800">
              <span>Resiliencia y memoria histórica</span>
              <span aria-hidden="true">&rarr;</span>
            </div>
          </article>
        </div>
      </div>
    </section>

