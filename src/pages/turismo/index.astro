---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const destinos = await getCollection('turismo');
---

<Layout title="Identidad y Turismo en Pontó | Pukapacha">
  <main class="min-h-screen bg-stone-950 text-white">
    <section class="relative isolate overflow-hidden border-b border-[#7c2d12]/40 bg-gradient-to-br from-[#240c07] via-[#4d190f] to-[#7c2b1a]">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_76%_30%,rgba(249,115,22,0.22),transparent_28%),linear-gradient(120deg,rgba(36,14,8,0.95),rgba(20,7,4,0.7))]"></div>
      <div class="relative mx-auto flex min-h-[560px] max-w-7xl items-end px-5 pb-16 pt-36 sm:px-8 sm:pb-20 lg:min-h-[620px] lg:px-10">
        <div class="max-w-4xl">
          <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-amber-300"><span class="h-px w-9 bg-amber-400"></span>Destino Pontó · Pukapacha</p>
          <h1 class="mt-5 max-w-4xl text-5xl font-black leading-[0.98] tracking-tight text-white sm:text-7xl lg:text-8xl">Riqueza cultural e histórica de Pontó</h1>
          <p class="mt-7 max-w-2xl text-base leading-7 text-stone-200 sm:text-lg">Recorre paisajes de tierra colorada, tradiciones vivas y parajes que guardan la memoria comunitaria de nuestro distrito en Áncash.</p>
          <a href="#destinos" class="mt-9 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 px-5 py-3.5 text-sm font-black text-stone-950 shadow-lg shadow-black/30 transition hover:brightness-110 focus:outline-2 focus:outline-offset-4 focus:outline-amber-400">Explorar destinos <span aria-hidden="true">&#8595;</span></a>
        </div>
      </div>
    </section>

    <section id="destinos" class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20 lg:px-10" aria-labelledby="destinos-titulo">
      <div class="mb-9 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-400">Conoce nuestro territorio</p>
          <h2 id="destinos-titulo" class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">Lugares para descubrir</h2>
        </div>
        <p class="text-sm font-semibold text-stone-400">{destinos.length} {destinos.length === 1 ? 'destino registrado' : 'destinos registrados'}</p>
      </div>

      {destinos.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {destinos.map((destino, index) => (
            <article class:list={["group relative min-h-[420px] overflow-hidden rounded-xl border border-white/10 bg-stone-900 shadow-xl shadow-black/30 transition-all hover:border-amber-400/40", index === 0 && "md:col-span-2 lg:row-span-2 lg:min-h-[620px]"]}>
              <img src={destino.data.imagen} alt={`Paisaje de ${destino.data.titulo}`} class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading={index === 0 ? 'eager' : 'lazy'} />
              <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/40 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
                <p class="flex items-start gap-2 text-xs font-bold uppercase tracking-[0.16em] text-amber-300"><span aria-hidden="true">&#9679;</span> {destino.data.ubicacion}</p>
                <h3 class="mt-3 text-2xl font-black leading-tight text-white sm:text-3xl">{destino.data.titulo}</h3>
                <p class="mt-3 max-w-xl text-sm leading-6 text-slate-200">{destino.data.descripcion}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-white/20 bg-white/5 px-6 py-16 text-center">
          <h2 class="text-xl font-bold text-white">Próximamente conocerás nuestros destinos</h2>
          <p class="mt-2 text-sm text-slate-400">Estamos preparando nuevas historias y lugares para descubrir.</p>
        </div>
      )}
    </section>

  </main>
</Layout>
