---
import Layout from '../layouts/Layout.astro';

// Ejes del Diagnóstico Cualitativo
const sectoresDiagnostico = [
  {
    id: 'vias',
    titulo: 'Infraestructura y Vías',
    acento: 'slate',
    badgeText: 'Atención Urgente',
    badgeClass: 'bg-slate-100 text-slate-700 border-slate-200',
    iconBorder: 'border-slate-200 bg-slate-100 text-slate-700',
    hoverBorder: 'hover:border-slate-400',
    descripcion: 'La red de trochas y caminos vecinales que conecta a la capital Pontó con los centros poblados de San Miguel y Conin, así como con los 14 anexos, presenta un deterioro constante debido a la geografía accidentada y la falta de mantenimiento periódico.',
    hallazgos: [
      {
        titulo: 'Aislamiento en temporada de lluvias',
        detalle: 'Las precipitaciones intensas provocan deslizamientos y lodazales en puntos críticos, dificultando el tránsito de pasajeros y el traslado oportuno de emergencias de salud.',
      },
      {
        titulo: 'Falta de ensanche y cunetas de drenaje',
        detalle: 'Gran parte de las trochas no cuenta con cunetas adecuadas, lo que ocasiona que el agua discurra por la calzada y destruya el afirmado rústico.',
      },
      {
        titulo: 'Puentes y pasos peatonales precarios',
        detalle: 'En quebradas secundarias de varios anexos, los accesos peatonales y vehiculares requieren mejoramiento estructural para garantizar cruces seguros.',
      },
    ],
  },
  {
    id: 'agua',
    titulo: 'Agricultura y Agua',
    acento: 'emerald',
    badgeText: 'Necesidad Prioritaria',
    badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    iconBorder: 'border-emerald-100 bg-emerald-50 text-emerald-600',
    hoverBorder: 'hover:border-emerald-300',
    descripcion: 'La agricultura familiar y comunal constituye el sustento primordial de la población. Sin embargo, la dependencia exclusiva de las lluvias de temporada y la pérdida de agua en canales rústicos limitan la seguridad alimentaria y económica de los productores.',
    hallazgos: [
      {
        titulo: 'Déficit hídrico en época de estiaje',
        detalle: 'Durante los meses de seca, el caudal de los manantiales y riachuelos desciende notoriamente, reduciendo drásticamente la capacidad de riego en los sembríos.',
      },
      {
        titulo: 'Pérdida de agua por canales de tierra',
        detalle: 'La mayoría de los canales de regadío son rústicos, provocando una alta pérdida de caudal por filtración e infiltración antes de llegar a las parcelas.',
      },
      {
        titulo: 'Carencia de riego tecnificado',
        detalle: 'Existe una necesidad generalizada de implementar sistemas por aspersión y goteo para cultivos de frutales en los valles templados y tubérculos en las partes altas.',
      },
    ],
  },
  {
    id: 'salud-educacion',
    titulo: 'Salud y Educación',
    acento: 'amber',
    badgeText: 'Atención Social',
    badgeClass: 'bg-amber-50 text-amber-800 border-amber-200',
    iconBorder: 'border-amber-100 bg-amber-50 text-amber-600',
    hoverBorder: 'hover:border-amber-300',
    descripcion: 'El bienestar de las familias campesinas y el desarrollo de la niñez exigen servicios básicos de calidad en el territorio. Las distancias geográficas entre los anexos y la capital distrital profundizan las brechas de atención.',
    hallazgos: [
      {
        titulo: 'Cobertura médica y medicamentos',
        detalle: 'Las postas médicas del distrito requieren un abastecimiento continuo de medicinas esenciales y presencia permanente de personal de salud para atender contingencias.',
      },
      {
        titulo: 'Lucha comunal contra la anemia infantil',
        detalle: 'Se evidencia la necesidad de programas nutricionales preventivos articulados con la producción agropecuaria andina de la propia zona.',
      },
      {
        titulo: 'Mantenimiento de infraestructura escolar',
        detalle: 'Las instituciones educativas en los anexos requieren mantenimiento preventivo en aulas, servicios higiénicos dignos y espacios recreativos seguros.',
      },
    ],
  },
  {
    id: 'conectividad',
    titulo: 'Conectividad y Telecomunicaciones',
    acento: 'rose',
    badgeText: 'Brecha Generalizada',
    badgeClass: 'bg-red-50 text-red-700 border-red-200',
    iconBorder: 'border-red-100 bg-red-50 text-red-600',
    hoverBorder: 'hover:border-red-300',
    descripcion: 'La falta de conectividad móvil e internet es una de las limitaciones más sentidas por los pobladores. Esta situación aísla comunicacionalmente al distrito frente a trámites, emergencias y oportunidades educativas.',
    hallazgos: [
      {
        titulo: 'Falta de cobertura móvil en anexos',
        detalle: 'En gran parte de los caseríos la señal celular es débil o nula, obligando a los vecinos a trasladarse a lomas y cerros elevados para realizar llamadas básicas.',
      },
      {
        titulo: 'Desconexión digital en las escuelas',
        detalle: 'La mayoría de estudiantes y docentes de zonas rurales no cuenta con acceso a internet para investigación pedagógica y desarrollo de habilidades digitales.',
      },
      {
        titulo: 'Dificultad para coordinar emergencias',
        detalle: 'Ante contingencias de salud o desastres naturales en temporada de lluvias, la comunicación inmediata con centros de apoyo provincial se ve seriamente afectada.',
      },
    ],
  },
];

// Alertas Cualitativas de Mayor Urgencia
const alertasCualitativas = [
  {
    tema: 'Red Vial y Transporte',
    alerta: 'Aislamiento en Temporada de Lluvias',
    descripcion: 'Vías que unen la capital con los anexos sufren cortes frecuentes por deslizamientos, dejando incomunicadas a las comunidades durante los meses más lluviosos del año.',
    badge: 'Urgencia Estacional',
    badgeClass: 'bg-amber-100 text-amber-800 border-amber-200',
    cardBorder: 'border-amber-200/80 bg-amber-50/50',
    icono: '🌧️',
  },
  {
    tema: 'Recursos Hídricos',
    alerta: 'Escasez en Época de Estiaje',
    descripcion: 'El agua para la agricultura disminuye críticamente entre junio y octubre, afectando la producción de la mayoría de familias campesinas por falta de reservorios y cochas.',
    badge: 'Prioridad Agraria',
    badgeClass: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    cardBorder: 'border-emerald-200/80 bg-emerald-50/40',
    icono: '🌱',
  },
  {
    tema: 'Comunicaciones',
    alerta: 'Brecha Generalizada de Internet',
    descripcion: 'La carencia de telefonía e internet móvil afecta tanto la educación escolar como la coordinación rápida de emergencias médicas en gran parte del distrito.',
    badge: 'Brecha Crítica',
    badgeClass: 'bg-red-100 text-red-800 border-red-200',
    cardBorder: 'border-red-200/80 bg-red-50/40',
    icono: '📡',
  },
];
---

<Layout
  title="Diagnóstico Territorial | Distrito de Pontó · Pukapacha"
  description="Línea de base cualitativa, análisis de necesidades y realidades prioritarias de la capital, los 2 centros poblados y los 14 anexos de Pontó, Huari, Áncash."
>
  <div class="min-h-screen bg-slate-50/70 text-slate-800">
    <!-- BLOQUE 1: HERO DE DIAGNÓSTICO (Limpio, profesional y cualitativo) -->
    <section class="relative isolate overflow-hidden border-b border-slate-200/70 bg-white px-5 pb-16 pt-16 sm:px-8 sm:pb-24 sm:pt-20 lg:px-10 shadow-xs">
      <!-- Fondo neutro que brinda respiro visual -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-100/60 via-white to-white"></div>

      <div class="relative mx-auto max-w-4xl text-center">
        <!-- Badge institucional de diagnóstico -->
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-slate-600 shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-red-600"></span>
          Evaluación Comunal y Técnica
        </span>

        <!-- Título principal -->
        <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Diagnóstico <span class="text-red-600">Territorial</span>
        </h1>

        <!-- Subtítulo cualitativo sin datos ficticios -->
        <p class="mx-auto mt-4 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg sm:leading-8">
          Un análisis cualitativo y transparente que documenta la realidad de nuestra <strong class="text-slate-900">capital Pontó</strong>, los <strong class="text-slate-900">2 centros poblados</strong> (San Miguel y Conin) y los <strong class="text-slate-900">14 anexos</strong> comunales. Reconocer con honestidad las dificultades que enfrentamos día a día es la única base para proyectar soluciones duraderas.
        </p>

        <!-- Etiquetas de enfoque metodológico (Pills descriptivas) -->
        <div class="mt-8 flex flex-wrap justify-center gap-2.5 sm:gap-3 text-xs font-bold text-slate-700">
          <span class="rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 shadow-2xs">
            📍 Capital, 2 Centros Poblados y 14 Anexos
          </span>
          <span class="rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 shadow-2xs">
            🤝 Basado en la Realidad Comunal
          </span>
          <span class="rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 shadow-2xs">
            🔍 Identificación de Brechas Reales
          </span>
        </div>
      </div>
    </section>

    <!-- BLOQUE 2: REALIDADES DESTACADAS (Cajas de Alerta Cualitativas) -->
    <section class="px-5 py-16 sm:px-8 sm:py-20 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 text-center sm:text-left">
          <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-slate-500">
            <span class="h-2 w-2 rounded-full bg-red-600"></span>
            Problemáticas Más Sentidas
          </span>
          <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
            Realidades Prioritarias del Distrito
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
            Desafíos cotidianos que impactan directamente a la mayoría de pobladores en las diferentes cuencas y sectores:
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-3">
          {alertasCualitativas.map((alerta) => (
            <article class={`rounded-3xl border p-7 shadow-xs transition hover:shadow-md ${alerta.cardBorder}`}>
              <div class="flex items-center justify-between">
                <span class="text-2xl" aria-hidden="true">{alerta.icono}</span>
                <span class={`rounded-full border px-3 py-0.5 text-[11px] font-bold uppercase tracking-wider ${alerta.badgeClass}`}>
                  {alerta.badge}
                </span>
              </div>

              <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                {alerta.tema}
              </p>
              <h3 class="mt-1 text-lg font-black text-slate-900">
                {alerta.alerta}
              </h3>
              <p class="mt-2.5 text-sm leading-6 text-slate-600">
                {alerta.descripcion}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOQUE 3: CUADRÍCULA DE SECTORES (Grid con Badges de Estado y sin porcentajes) -->
    <section class="border-t border-slate-200/70 bg-white px-5 py-20 sm:px-8 sm:py-28 lg:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 text-center sm:text-left">
          <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-slate-600">
            <span class="h-1.5 w-1.5 rounded-full bg-red-600"></span>
            Ejes Estratégicos Evaluados
          </span>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
            Sectores Clave y Necesidades Identificadas
          </h2>
          <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
            Descripción cualitativa del estado de la infraestructura, los recursos naturales, los servicios sociales y las telecomunicaciones en el territorio pontonino.
          </p>
        </div>

        <!-- Grid 2x2 de los 4 sectores requeridos -->
        <div class="grid gap-8 lg:grid-cols-2">
          <!-- SECTOR 1: Infraestructura y Vías -->
          <article class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-slate-400 hover:shadow-xl hover:shadow-slate-950/5 sm:p-9">
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono SVG Minimalista: Vías / Caminos -->
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-slate-200 bg-slate-100 text-slate-700 transition duration-300 group-hover:scale-110">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 19 8 5m8 0 4 14M12 5v2m0 5v2m0 5v2" />
                  </svg>
                </div>
                <!-- Badge de Nivel de Necesidad (Pill) -->
                <span class="rounded-full border border-slate-200 bg-slate-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-slate-700">
                  Atención Urgente
                </span>
              </div>

              <h3 class="mt-6 text-2xl font-black text-slate-900 group-hover:text-slate-800 transition-colors">
                Infraestructura y Vías
              </h3>

              <p class="mt-3 text-sm leading-7 text-slate-600">
                La orografía agreste de Pontó exige una red vial permanentemente transitable para garantizar el flujo de personas, víveres y emergencias entre la capital y todas sus comunidades.
              </p>

              <!-- Lista de Realidades Cualitativas -->
              <div class="mt-6 space-y-3">
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800">
                    Mantenimiento de trochas carrozables
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Necesidad prioritaria en todos los anexos para ensanchar caminos, construir cunetas y evitar que el afirmado rústico desaparezca tras las lluvias.
                  </p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800">
                    Aislamiento estacional
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    En temporada de lluvias, varios caseríos quedan en riesgo de aislamiento temporal por derrumbes en laderas escarpadas.
                  </p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800">
                    Puentes y cruces seguros
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Se requiere acondicionar pases peatonales y vehiculares en quebradas interconectadas para resguardar la seguridad de escolares y agricultores.
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-slate-100 pt-4 text-xs font-bold text-slate-500">
              <span>Estado Territorial:</span>
              <span class="text-slate-800">Prioridad en Red Vial Vecinal &rarr;</span>
            </div>
          </article>

          <!-- SECTOR 2: Agricultura y Agua -->
          <article class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-emerald-300 hover:shadow-xl hover:shadow-emerald-950/5 sm:p-9">
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono SVG Minimalista: Agua / Agricultura -->
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-100 bg-emerald-50 text-emerald-600 transition duration-300 group-hover:scale-110">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a7.5 7.5 0 0 0 7.5-7.5c0-4.14-7.5-11.25-7.5-11.25S4.5 9.36 4.5 13.5A7.5 7.5 0 0 0 12 21Z" />
                  </svg>
                </div>
                <!-- Badge de Nivel de Necesidad (Pill) -->
                <span class="rounded-full border border-emerald-200/70 bg-emerald-50/70 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-800">
                  Necesidad Prioritaria
                </span>
              </div>

              <h3 class="mt-6 text-2xl font-black text-slate-900 group-hover:text-emerald-900 transition-colors">
                Agricultura y Agua
              </h3>

              <p class="mt-3 text-sm leading-7 text-slate-600">
                La optimización del recurso hídrico es la demanda más recurrente de los productores agrícolas, quienes enfrentan severas restricciones para regar sus parcelas fuera de los meses de lluvia.
              </p>

              <!-- Lista de Realidades Cualitativas -->
              <div class="mt-6 space-y-3">
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-900">
                    Siembra y cosecha de agua
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Urgencia de construir reservorios familiares y cochas comunales en cabeceras de cuenca para retener agua y enfrentar la temporada de estiaje.
                  </p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-900">
                    Eficiencia en canales de regadío
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    La gran mayoría de acequias son de tierra, provocando pérdidas considerables por evaporación e infiltración en su trayecto.
                  </p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-900">
                    Tecnificación del riego
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Oportunidad de transicionar progresivamente hacia el riego presurizado (aspersión y goteo) para frutales y sembríos andinos.
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-slate-100 pt-4 text-xs font-bold text-slate-500">
              <span>Estado Territorial:</span>
              <span class="text-emerald-700">Seguridad Hídrica Productiva &rarr;</span>
            </div>
          </article>

          <!-- SECTOR 3: Salud y Educación -->
          <article class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-xl hover:shadow-amber-950/5 sm:p-9">
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono SVG Minimalista: Salud / Educación -->
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-amber-100 bg-amber-50 text-amber-600 transition duration-300 group-hover:scale-110">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                  </svg>
                </div>
                <!-- Badge de Nivel de Necesidad (Pill) -->
                <span class="rounded-full border border-amber-200/70 bg-amber-50/70 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-800">
                  Atención Social
                </span>
              </div>

              <h3 class="mt-6 text-2xl font-black text-slate-900 group-hover:text-amber-900 transition-colors">
                Salud y Educación
              </h3>

              <p class="mt-3 text-sm leading-7 text-slate-600">
                El bienestar integral de la primera infancia y el acceso continuo a atención médica en el primer nivel constituyen la base indispensable del desarrollo humano en Pontó.
              </p>

              <!-- Lista de Realidades Cualitativas -->
              <div class="mt-6 space-y-3">
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-amber-900">
                    Abastecimiento de postas de salud
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Necesidad de garantizar stock oportuno de medicamentos de primeros auxilios y presencia de personal de salud en puntos estratégicos.
                  </p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-amber-900">
                    Nutrición y desarrollo infantil
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Articulación de programas comunitarios contra la anemia con participación directa de promotores de salud y madres de familia.
                  </p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-amber-900">
                    Condiciones en locales escolares
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Mantenimiento de techos, servicios de agua segura y equipamiento básico para el aprendizaje de niños en caseríos alejados.
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-slate-100 pt-4 text-xs font-bold text-slate-500">
              <span>Estado Territorial:</span>
              <span class="text-amber-700">Bienestar y Desarrollo Humano &rarr;</span>
            </div>
          </article>

          <!-- SECTOR 4: Conectividad y Telecomunicaciones -->
          <article class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-red-300 hover:shadow-xl hover:shadow-red-950/5 sm:p-9">
            <div>
              <div class="flex items-center justify-between">
                <!-- Ícono SVG Minimalista: Antena / Señal / Conectividad -->
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-red-100 bg-red-50 text-red-600 transition duration-300 group-hover:scale-110">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856a9.75 9.75 0 0 1 13.788 0M1.924 8.674a14.25 14.25 0 0 1 20.152 0M12 18.75h.007v.008H12v-.008Z" />
                  </svg>
                </div>
                <!-- Badge de Nivel de Necesidad (Pill) -->
                <span class="rounded-full border border-red-200/70 bg-red-50/70 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-red-700">
                  Brecha Generalizada
                </span>
              </div>

              <h3 class="mt-6 text-2xl font-black text-slate-900 group-hover:text-red-700 transition-colors">
                Conectividad y Telecomunicaciones
              </h3>

              <p class="mt-3 text-sm leading-7 text-slate-600">
                La falta de cobertura de internet y telefonía móvil es una realidad palpable en gran parte del distrito, limitando la integración con los servicios públicos y la economía digital.
              </p>

              <!-- Lista de Realidades Cualitativas -->
              <div class="mt-6 space-y-3">
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-red-800">
                    Deficiente señal telefónica
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    La mayoría de los caseríos carece de señal móvil estable, obligando a los vecinos a buscar puntos altos para comunicarse con familiares o coordinar labores.
                  </p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-red-800">
                    Brecha de internet en escuelas
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Escuelas rurales sin acceso a conectividad, limitando el acceso de los alumnos a contenidos educativos y herramientas digitales.
                  </p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-red-800">
                    Gestión de emergencias
                  </h4>
                  <p class="mt-1 text-xs leading-5 text-slate-600">
                    Dificultad para coordinar alertas tempranas o pedir ambulancias y auxilio de forma inmediata ante desastres naturales o accidentes.
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-slate-100 pt-4 text-xs font-bold text-slate-500">
              <span>Estado Territorial:</span>
              <span class="text-red-700">Integración Digital Inmediata &rarr;</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- BLOQUE 4: LLAMADO A LA ACCIÓN (Conexión Amigable con 'Participa') -->
